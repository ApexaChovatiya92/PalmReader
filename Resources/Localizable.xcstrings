    "disclaimer.point1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Palm is for entertainment and self-reflection, based on traditional palmistry."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑरा पाम पारंपरिक हस्तरेखा शास्त्र पर आधारित मनोरंजन और आत्म-चिंतन के लिए है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অরা পাম ঐতিহ্যবাহী হস্তরেখা বিদ্যার ভিত্তিতে বিনোদন ও আত্মচিন্তনের জন্য।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑरा पाम पारंपरिक हस्तरेषा शास्त्रावर आधारित मनोरंजन आणि आत्मचिंतनासाठी आहे."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆరా పామ్ సంప్రదాయ హస్తసాముద్రికం ఆధారంగా వినోదం మరియు ఆత్మపరిశీలన కోసం మాత్రమే."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆரா பாம் பாரம்பரிய கைரேகை சாஸ்திரத்தை அடிப்படையாகக் கொண்ட பொழுதுபோக்கு மற்றும் சுயசிந்தனைக்கானது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓરા પામ પરંપરાગત હસ્તરેખા શાસ્ત્ર પર આધારિત મનોરંજન અને આત્મચિંતન માટે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرا پام روایتی دست شناسی پر مبنی تفریح اور خود شناسی کے لیے ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆರಾ ಪಾಮ್ ಸಾಂಪ್ರದಾಯಿಕ ಹಸ್ತಸಾಮುದ್ರಿಕ ಆಧಾರಿತ ಮನರಂಜನೆ ಮತ್ತು ಆತ್ಮಾವಲೋಕನಕ್ಕಾಗಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅରା ପାମ ପାରମ୍ପରିକ ହସ୍ତରେଖା ଶାସ୍ତ୍ର ଆଧାରିତ ମନୋରଞ୍ଜନ ଓ ଆତ୍ମଚିନ୍ତନ ପାଇଁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓറ പാം പരമ്പരാഗത ഹസ്തരേഖാ ശാസ്ത്രത്തെ അടിസ്ഥാനമാക്കിയുള്ള വിനോദത്തിനും ആത്മചിന്തയ്ക്കും വേണ്ടിയുള്ളതാണ്."
          }
        }
      }
    },
    "disclaimer.point2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not predict the future and is not medical, financial, legal or life advice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह भविष्य नहीं बताता और यह चिकित्सा, वित्तीय, कानूनी या जीवन संबंधी सलाह नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ভবিষ্যৎ বলে না এবং এটি চিকিৎসা, আর্থিক, আইনি বা জীবন-সংক্রান্ত পরামর্শ নয়।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते भविष्य सांगत नाही आणि ते वैद्यकीय, आर्थिक, कायदेशीर किंवा जीवनविषयक सल्ला नाही."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది భవిష్యత్తును చెప్పదు, మరియు ఇది వైద్య, ఆర్థిక, న్యాయ లేదా జీవిత సలహా కాదు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது எதிர்காலத்தைக் கணிப்பதில்லை; இது மருத்துவ, நிதி, சட்ட அல்லது வாழ்க்கை ஆலோசனை அல்ல."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે ભવિષ્ય ભાખતું નથી અને તે તબીબી, નાણાકીય, કાનૂની કે જીવન સંબંધી સલાહ નથી."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مستقبل کی پیش گوئی نہیں کرتا اور یہ طبی، مالی، قانونی یا زندگی سے متعلق مشورہ نہیں ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಭವಿಷ್ಯವನ್ನು ಊಹಿಸುವುದಿಲ್ಲ, ಮತ್ತು ಇದು ವೈದ್ಯಕೀಯ, ಆರ್ಥಿಕ, ಕಾನೂನು ಅಥವಾ ಜೀವನ ಸಲಹೆಯಲ್ಲ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଭବିଷ୍ୟତ କହେ ନାହିଁ ଏବଂ ଏହା ଚିକିତ୍ସା, ଆର୍ଥିକ, ଆଇନଗତ ବା ଜୀବନ ସମ୍ବନ୍ଧୀୟ ପରାମର୍ଶ ନୁହେଁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഭാവി പ്രവചിക്കുന്നില്ല; ഇത് വൈദ്യ, സാമ്പത്തിക, നിയമ, ജീവിത ഉപദേശമല്ല."
          }
        }
      }
    },
    "disclaimer.point3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos, readings and notes stay on your device. Nothing is uploaded or shared."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो, रीडिंग और नोट्स आपके डिवाइस पर ही रहते हैं। कुछ भी अपलोड या साझा नहीं किया जाता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ছবি, পাঠ ও নোট আপনার ডিভাইসেই থাকে। কিছুই আপলোড বা শেয়ার করা হয় না।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे फोटो, वाचन आणि नोंदी तुमच्या डिव्हाइसवरच राहतात. काहीही अपलोड किंवा शेअर केले जात नाही."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలు, పఠనాలు మరియు గమనికలు మీ పరికరంలోనే ఉంటాయి. ఏదీ అప్‌లోడ్ లేదా షేర్ చేయబడదు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் படங்கள், வாசிப்புகள் மற்றும் குறிப்புகள் உங்கள் சாதனத்திலேயே இருக்கும். எதுவும் பதிவேற்றப்படுவதோ பகிரப்படுவதோ இல்லை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોટા, વાંચન અને નોંધો તમારા ઉપકરણ પર જ રહે છે. કંઈ પણ અપલોડ કે શેર થતું નથી."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تصاویر، ریڈنگز اور نوٹس آپ کے آلے پر ہی رہتے ہیں۔ کچھ بھی اپ لوڈ یا شیئر نہیں کیا جاتا۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳು, ಓದುಗಳು ಮತ್ತು ಟಿಪ್ಪಣಿಗಳು ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಇರುತ್ತವೆ. ಯಾವುದನ್ನೂ ಅಪ್‌ಲೋಡ್ ಅಥವಾ ಹಂಚಿಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଫଟୋ, ପଠନ ଓ ଟିପ୍ପଣୀ ଆପଣଙ୍କ ଡିଭାଇସରେ ହିଁ ରହେ। କିଛି ବି ଅପଲୋଡ ବା ସେୟାର କରାଯାଏ ନାହିଁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകളും വായനകളും കുറിപ്പുകളും നിങ്ങളുടെ ഉപകരണത്തിൽ തന്നെ തുടരുന്നു. ഒന്നും അപ്‌ലോഡ് ചെയ്യുകയോ പങ്കിടുകയോ ചെയ്യുന്നില്ല."
          }
        }
      }
    },
    "disclaimer.title": {
