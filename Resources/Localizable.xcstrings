    "element.earth.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A square palm with shorter fingers. Traditionally practical, reliable and grounded, with a love of working with the hands."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्गाकार हथेली और छोटी उंगलियाँ। परंपरागत रूप से व्यावहारिक, भरोसेमंद और ज़मीन से जुड़े, हाथों से काम करना पसंद करने वाले।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্গাকার তালু ও ছোট আঙুল। ঐতিহ্যগতভাবে বাস্তববাদী, নির্ভরযোগ্য ও মাটির কাছের, হাতে কাজ করতে ভালোবাসেন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चौकोनी तळहात आणि लहान बोटे. परंपरेनुसार व्यावहारिक, विश्वासार्ह आणि जमिनीशी जोडलेले, हाताने काम करायला आवडणारे."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చతురస్రాకార అరచేతి, పొట్టి వేళ్లు. సంప్రదాయంగా ఆచరణాత్మకం, నమ్మదగినవారు, నేలకు దగ్గరగా ఉండేవారు, చేతులతో పని చేయడం ఇష్టపడేవారు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சதுர உள்ளங்கை, குட்டையான விரல்கள். மரபுப்படி நடைமுறைவாதிகள், நம்பகமானவர்கள், நிலைத்தவர்கள், கைகளால் வேலை செய்வதை விரும்புபவர்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચોરસ હથેળી અને ટૂંકી આંગળીઓ. પરંપરાગત રીતે વ્યવહારુ, ભરોસાપાત્ર અને જમીન સાથે જોડાયેલા, હાથથી કામ કરવાનું પસંદ કરનારા."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چوکور ہتھیلی اور چھوٹی انگلیاں۔ روایتی طور پر عملی، قابلِ اعتماد اور زمین سے جڑے، ہاتھوں سے کام کرنا پسند کرنے والے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚೌಕ ಅಂಗೈ ಮತ್ತು ಗಿಡ್ಡ ಬೆರಳುಗಳು. ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಪ್ರಾಯೋಗಿಕ, ವಿಶ್ವಾಸಾರ್ಹ ಮತ್ತು ನೆಲಕ್ಕೆ ಹತ್ತಿರವಾದವರು, ಕೈಗಳಿಂದ ಕೆಲಸ ಮಾಡಲು ಇಷ್ಟಪಡುವವರು."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବର୍ଗାକାର ପାପୁଲି ଓ ଛୋଟ ଆଙ୍ଗୁଠି। ପରମ୍ପରା ଅନୁସାରେ ବ୍ୟାବହାରିକ, ଭରସାଯୋଗ୍ୟ ଓ ମାଟି ସହ ଯୋଡ଼ା, ହାତରେ କାମ କରିବାକୁ ଭଲ ପାଆନ୍ତି।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചതുര കൈപ്പത്തിയും നീളം കുറഞ്ഞ വിരലുകളും. പരമ്പരാഗതമായി പ്രായോഗികം, വിശ്വസ്തർ, മണ്ണിനോട് ചേർന്നവർ, കൈകൊണ്ട് പണിയെടുക്കാൻ ഇഷ്ടമുള്ളവർ."
          }
        }
      }
    },
