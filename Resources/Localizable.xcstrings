    "handShape.palm.square.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionally linked with a practical, steady, hands-on nature."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरागत रूप से व्यावहारिक, स्थिर और कर्मठ स्वभाव से जुड़ी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐতিহ্যগতভাবে বাস্তববাদী, স্থির ও কর্মঠ স্বভাবের সঙ্গে যুক্ত।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरेनुसार व्यावहारिक, स्थिर आणि कामसू स्वभावाशी जोडलेला."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంప్రదాయంగా ఆచరణాత్మకమైన, స్థిరమైన, కష్టపడి పనిచేసే స్వభావంతో ముడిపడి ఉంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மரபுப்படி நடைமுறையான, நிலையான, உழைப்பாளி இயல்புடன் தொடர்புடையது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરંપરાગત રીતે વ્યવહારુ, સ્થિર અને કર્મઠ સ્વભાવ સાથે જોડાયેલી."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روایتی طور پر عملی، مستحکم اور محنتی مزاج سے منسلک۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಪ್ರಾಯೋಗಿಕ, ಸ್ಥಿರ ಮತ್ತು ಶ್ರಮಜೀವಿ ಸ್ವಭಾವಕ್ಕೆ ಸಂಬಂಧಿಸಿದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରମ୍ପରା ଅନୁସାରେ ବ୍ୟାବହାରିକ, ସ୍ଥିର ଓ ପରିଶ୍ରମୀ ସ୍ୱଭାବ ସହ ଜଡ଼ିତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമ്പരാഗതമായി പ്രായോഗികവും സ്ഥിരവും അധ്വാനശീലവുമായ സ്വഭാവവുമായി ബന്ധപ്പെട്ടത്."
          }
        }
      }
    },
