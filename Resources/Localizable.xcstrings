          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಂಗುರದ ಬೆರಳು ಉದ್ದ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନାମିକା ଲମ୍ବା"
          }
