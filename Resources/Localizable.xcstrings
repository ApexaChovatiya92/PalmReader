    "mount.mercury.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Mercury mount signifies sharp conversational agility, commerce intuition, and rapid analytical comprehension."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय बुध पर्वत तीक्ष्ण वाक्-चातुर्य, व्यापारिक अंतर्ज्ञान और तेज़ विश्लेषणात्मक समझ का संकेत है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সক্রিয় বুধ পর্বত তীক্ষ্ণ বাকপটুতা, ব্যবসায়িক বোধ এবং দ্রুত বিশ্লেষণী বোধশক্তির ইঙ্গিত দেয়।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय बुध पर्वत तल्लख संभाषणकौशल्य, व्यापारी अंतःप्रेरणा आणि जलद विश्लेषणात्मक आकलन दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చురుకైన బుధ పర్వతం పదునైన మాటకారితనం, వ్యాపార అంతర్బుద్ధి మరియు వేగవంతమైన విశ్లేషణాత్మక అవగాహనను సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுறுசுறுப்பான புதன் மேடு கூர்மையான பேச்சுத்திறன், வணிக உள்ளுணர்வு மற்றும் விரைவான பகுப்பாய்வுப் புரிதலைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સક્રિય બુધ પર્વત તીક્ષ્ણ વાક્ચાતુર્ય, વ્યાપારી સૂઝ અને ઝડપી વિશ્લેષણાત્મક સમજનો સંકેત છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال عطارد کا ابھار تیز گفتاری، تجارتی سوجھ بوجھ اور فوری تجزیاتی فہم کی علامت ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಕ್ರಿಯ ಬುಧ ಪರ್ವತವು ತೀಕ್ಷ್ಣ ಮಾತುಗಾರಿಕೆ, ವ್ಯಾಪಾರ ಅಂತಃಪ್ರಜ್ಞೆ ಮತ್ತು ತ್ವರಿತ ವಿಶ್ಲೇಷಣಾತ್ಮಕ ಗ್ರಹಿಕೆಯನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସକ୍ରିୟ ବୁଧ ପର୍ବତ ତୀକ୍ଷ୍ଣ ବାକ୍‌ପଟୁତା, ବ୍ୟବସାୟିକ ଅନ୍ତର୍ଜ୍ଞାନ ଓ ଦ୍ରୁତ ବିଶ୍ଳେଷଣାତ୍ମକ ବୁଝାମଣାର ସଙ୍କେତ ଦିଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സജീവമായ ബുധ പർവ്വതം മൂർച്ചയുള്ള സംഭാഷണചാതുര്യം, വാണിജ്യ അന്തർജ്ഞാനം, വേഗത്തിലുള്ള വിശകലന ഗ്രഹണശേഷി എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
