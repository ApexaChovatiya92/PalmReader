            "value": "అరచేతి మంచి ఫోటో ఎలా తీయాలి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளங்கையை நன்றாகப் படம் எடுப்பது எப்படி"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હથેળીનો સારો ફોટો કેવી રીતે લેવો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
