            "value": "Dynamic Explorer & Adaptable Path"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिशील अन्वेषक और लचीला मार्ग"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গতিশীল অন্বেষক ও নমনীয় পথ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिशील शोधक आणि लवचिक मार्ग"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చైతన్యవంతమైన అన్వేషకుడు మరియు సరళమైన మార్గం"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "துடிப்பான ஆய்வாளர் மற்றும் நெகிழ்வான பாதை"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગતિશીલ શોધક અને લવચીક માર્ગ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متحرک کھوجی اور لچکدار راستہ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚೈತನ್ಯಶೀಲ ಅನ್ವೇಷಕ ಮತ್ತು ನಮ್ಯ ಪಥ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗତିଶୀଳ ଅନ୍ୱେଷକ ଓ ନମନୀୟ ପଥ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചലനാത്മക അന്വേഷകനും വഴക്കമുള്ള പാതയും"
          }
        }
      }
    },
