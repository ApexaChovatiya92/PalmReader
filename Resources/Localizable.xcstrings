          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणता पर्वत तर्जनीच्या खाली असतो?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ పర్వతం చూపుడు వేలి కింద ఉంటుంది?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த மேடு ஆள்காட்டி விரலின் கீழ் உள்ளது?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કયો પર્વત તર્જની આંગળી નીચે હોય છે?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کون سا ابھار شہادت کی انگلی کے نیچے ہوتا ہے؟"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವ ಪರ್ವತ ತೋರುಬೆರಳಿನ ಕೆಳಗೆ ಇರುತ್ತದೆ?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେଉଁ ପର୍ବତ ତର୍ଜନୀ ତଳେ ଥାଏ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചൂണ്ടുവിരലിന് താഴെയുള്ള പർവ്വതം ഏത്?"
          }
        }
      }
    },
