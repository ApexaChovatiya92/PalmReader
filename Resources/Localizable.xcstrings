        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्ञान आणि शिस्त"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జ్ఞానం మరియు క్రమశిక్షణ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஞானம் மற்றும் ஒழுக்கம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્ઞાન અને શિસ્ત"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دانائی اور نظم و ضبط"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾನ ಮತ್ತು ಶಿಸ್ತು"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଜ୍ଞାନ ଓ ଅନୁଶାସନ"
          }
