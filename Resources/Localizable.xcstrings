            "value": "ಆಯುಷ್ಯ ರೇಖೆಯ ಪಕ್ಕದಲ್ಲಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଜୀବନ ରେଖା ପାଖରେ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആയുർരേഖയ്ക്ക് സമീപം"
          }
        }
      }
    },
    "marking.square.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditional sign of preservation and protection through challenging transitions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कठिन परिवर्तनों के दौरान संरक्षण और सुरक्षा का पारंपरिक चिह्न।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কঠিন পরিবর্তনের সময় সুরক্ষা ও রক্ষার ঐতিহ্যবাহী চিহ্ন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कठीण बदलांच्या काळात जतन आणि संरक्षणाचे पारंपरिक चिन्ह."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కష్టమైన మార్పుల సమయంలో సంరక్షణ మరియు రక్షణకు సంప్రదాయ చిహ్నం."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடினமான மாற்றங்களின்போது காப்பும் பாதுகாப்பும் தரும் பாரம்பரியக் குறி."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મુશ્કેલ પરિવર્તનો દરમિયાન સંરક્ષણ અને સુરક્ષાનું પરંપરાગત ચિહ્ન."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشکل تبدیلیوں کے دوران حفاظت اور تحفظ کا روایتی نشان۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಠಿಣ ಬದಲಾವಣೆಗಳ ಸಮಯದಲ್ಲಿ ಸಂರಕ್ಷಣೆ ಮತ್ತು ರಕ್ಷಣೆಯ ಸಾಂಪ್ರದಾಯಿಕ ಚಿಹ್ನೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କଠିନ ପରିବର୍ତ୍ତନ ସମୟରେ ସୁରକ୍ଷା ଓ ସଂରକ୍ଷଣର ପାରମ୍ପରିକ ଚିହ୍ନ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രയാസകരമായ മാറ്റങ്ങളുടെ കാലത്ത് സംരക്ഷണത്തിന്റെയും സുരക്ഷയുടെയും പരമ്പരാഗത ചിഹ്നം."
          }
        }
      }
    },
