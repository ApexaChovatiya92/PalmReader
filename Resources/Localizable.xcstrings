    "mount.lowNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mount is less pronounced in your hand, so traditionally its qualities play a quieter, supporting role."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके हाथ में यह पर्वत कम उभरा है, इसलिए परंपरा के अनुसार इसके गुण शांत, सहायक भूमिका निभाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হাতে এই পর্বতটি কম উঁচু, তাই ঐতিহ্য অনুযায়ী এর গুণগুলো শান্ত, সহায়ক ভূমিকা পালন করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या हातात हा पर्वत कमी उठावदार आहे, त्यामुळे परंपरेनुसार त्याचे गुण शांत, सहायक भूमिका बजावतात."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చేతిలో ఈ పర్వతం తక్కువగా ఉబ్బి ఉంది, కాబట్టి సంప్రదాయం ప్రకారం దాని లక్షణాలు నిశ్శబ్దమైన, సహాయక పాత్ర పోషిస్తాయి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கையில் இந்த மேடு குறைவாக உயர்ந்துள்ளது, எனவே மரபுப்படி அதன் பண்புகள் அமைதியான, துணைப் பங்கை வகிக்கின்றன."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા હાથમાં આ પર્વત ઓછો ઊપસેલો છે, તેથી પરંપરા મુજબ તેના ગુણો શાંત, સહાયક ભૂમિકા ભજવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ہاتھ میں یہ ابھار کم نمایاں ہے، اس لیے روایت کے مطابق اس کی خوبیاں خاموش، معاون کردار ادا کرتی ہیں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕೈಯಲ್ಲಿ ಈ ಪರ್ವತ ಕಡಿಮೆ ಎದ್ದಿದೆ, ಆದ್ದರಿಂದ ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಅದರ ಗುಣಗಳು ಶಾಂತ, ಪೂರಕ ಪಾತ್ರ ವಹಿಸುತ್ತವೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ହାତରେ ଏହି ପର୍ବତ କମ ଉଚ୍ଚ, ତେଣୁ ପରମ୍ପରା ଅନୁସାରେ ଏହାର ଗୁଣ ଶାନ୍ତ, ସହାୟକ ଭୂମିକା ନିଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കൈയിൽ ഈ പർവ്വതം അത്ര ഉയർന്നിട്ടില്ല, അതിനാൽ പരമ്പരാഗതമായി അതിന്റെ ഗുണങ്ങൾ ശാന്തമായ, പിന്തുണ നൽകുന്ന പങ്ക് വഹിക്കുന്നു."
          }
        }
      }
    },
