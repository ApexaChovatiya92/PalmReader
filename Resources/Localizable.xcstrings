          }
        }
      }
    },
    "marking.triangle.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean triangle under Jupiter signifies diplomatic skill, wisdom in communication, and executive ability."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरु पर्वत के नीचे स्पष्ट त्रिकोण कूटनीतिक कौशल, संवाद में विवेक और प्रशासनिक क्षमता दर्शाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বৃহস্পতি পর্বতের নিচে স্পষ্ট ত্রিভুজ কূটনৈতিক দক্ষতা, যোগাযোগে প্রজ্ঞা ও প্রশাসনিক সক্ষমতা নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरु पर्वताखालील स्पष्ट त्रिकोण मुत्सद्दी कौशल्य, संवादातील शहाणपण आणि प्रशासकीय क्षमता दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గురు పర్వతం కింద స్పష్టమైన త్రిభుజం దౌత్య నైపుణ్యం, సంభాషణలో వివేకం మరియు నిర్వహణ సామర్థ్యాన్ని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரு மேட்டின் கீழ் தெளிவான முக்கோணம் ராஜதந்திரத் திறன், பேச்சில் ஞானம் மற்றும் நிர்வாகத் திறனைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગુરુ પર્વત નીચેનો સ્પષ્ટ ત્રિકોણ કૂટનીતિક કુશળતા, સંવાદમાં વિવેક અને વહીવટી ક્ષમતા દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشتری کے ابھار کے نیچے واضح مثلث سفارتی مہارت، گفتگو میں دانائی اور انتظامی صلاحیت ظاہر کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುರು ಪರ್ವತದ ಕೆಳಗಿನ ಸ್ಪಷ್ಟ ತ್ರಿಕೋನವು ರಾಜತಾಂತ್ರಿಕ ಕೌಶಲ, ಸಂವಹನದಲ್ಲಿ ವಿವೇಕ ಮತ್ತು ಆಡಳಿತ ಸಾಮರ್ಥ್ಯವನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୁରୁ ପର୍ବତ ତଳେ ସ୍ପଷ୍ଟ ତ୍ରିଭୁଜ କୂଟନୈତିକ ଦକ୍ଷତା, ଯୋଗାଯୋଗରେ ବିବେକ ଓ ପ୍ରଶାସନିକ କ୍ଷମତା ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗുരു പർവ്വതത്തിനു താഴെയുള്ള വ്യക്തമായ ത്രികോണം നയതന്ത്ര വൈദഗ്ധ്യം, ആശയവിനിമയത്തിലെ വിവേകം, ഭരണശേഷി എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
    "markings.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SPECIAL PALM MARKINGS"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हथेली के विशेष चिह्न"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তালুর বিশেষ চিহ্ন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तळहातावरील विशेष चिन्हे"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అరచేతిపై ప్రత్యేక చిహ్నాలు"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளங்கையின் சிறப்புக் குறிகள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હથેળીના વિશેષ ચિહ્નો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہتھیلی کے خاص نشانات"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂಗೈಯ ವಿಶೇಷ ಚಿಹ್ನೆಗಳು"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାପୁଲିର ବିଶେଷ ଚିହ୍ନ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൈപ്പത്തിയിലെ പ്രത്യേക ചിഹ്നങ്ങൾ"
          }
        }
      }
    },
    "markings.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No special markings were clearly visible in this photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो में कोई विशेष चिह्न साफ़ दिखाई नहीं दिया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ছবিতে কোনো বিশেষ চিহ্ন পরিষ্কার দেখা যায়নি।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोटोत कोणतेही विशेष चिन्ह स्पष्ट दिसले नाही."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోలో ప్రత్యేక చిహ్నాలు ఏవీ స్పష్టంగా కనిపించలేదు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் படத்தில் சிறப்புக் குறிகள் எதுவும் தெளிவாகத் தெரியவில்லை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટામાં કોઈ વિશેષ ચિહ્ન સ્પષ્ટ દેખાયું નહીં."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس تصویر میں کوئی خاص نشان واضح طور پر نظر نہیں آیا۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋದಲ್ಲಿ ಯಾವುದೇ ವಿಶೇಷ ಚಿಹ್ನೆಗಳು ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣಿಸಲಿಲ್ಲ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫଟୋରେ କୌଣସି ବିଶେଷ ଚିହ୍ନ ସ୍ପଷ୍ଟ ଦେଖାଗଲା ନାହିଁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോയിൽ പ്രത്യേക ചിഹ്നങ്ങളൊന്നും വ്യക്തമായി കണ്ടില്ല."
          }
        }
      }
    },
