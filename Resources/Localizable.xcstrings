    "about.what.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Palm traces the major lines of your palm from a photo and explains them using traditional palmistry, in your language, for fun and reflection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑरा पाम फ़ोटो से आपकी हथेली की मुख्य रेखाएँ खोजता है और मनोरंजन व चिंतन के लिए आपकी भाषा में पारंपरिक हस्तरेखा शास्त्र के अनुसार उनका अर्थ बताता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অরা পাম ছবি থেকে আপনার তালুর প্রধান রেখাগুলো খুঁজে বের করে এবং বিনোদন ও ভাবনার জন্য আপনার ভাষায় ঐতিহ্যবাহী হস্তরেখা বিদ্যা অনুযায়ী সেগুলোর অর্থ ব্যাখ্যা করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑरा पाम फोटोवरून तुमच्या तळहातावरील मुख्य रेषा शोधते आणि मनोरंजन व चिंतनासाठी तुमच्या भाषेत पारंपरिक हस्तरेषा शास्त्रानुसार त्यांचा अर्थ सांगते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆరా పామ్ ఫోటో నుండి మీ అరచేతిలోని ప్రధాన రేఖలను గుర్తించి, వినోదం మరియు ఆలోచన కోసం మీ భాషలో సంప్రదాయ హస్తసాముద్రికం ప్రకారం వాటి అర్థాన్ని వివరిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆரா பாம் படத்திலிருந்து உங்கள் உள்ளங்கையின் முக்கிய ரேகைகளைக் கண்டறிந்து, பொழுதுபோக்கு மற்றும் சிந்தனைக்காக உங்கள் மொழியில் பாரம்பரிய கைரேகை சாஸ்திரப்படி அவற்றை விளக்குகிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓરા પામ ફોટા પરથી તમારી હથેળીની મુખ્ય રેખાઓ શોધે છે અને મનોરંજન તથા ચિંતન માટે તમારી ભાષામાં પરંપરાગત હસ્તરેખા શાસ્ત્ર મુજબ તેમનો અર્થ સમજાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرا پام تصویر سے آپ کی ہتھیلی کی بنیادی لکیریں تلاش کرتا ہے اور تفریح اور غور و فکر کے لیے آپ کی زبان میں روایتی دست شناسی کے مطابق ان کی وضاحت کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆರಾ ಪಾಮ್ ಫೋಟೋದಿಂದ ನಿಮ್ಮ ಅಂಗೈಯ ಮುಖ್ಯ ರೇಖೆಗಳನ್ನು ಗುರುತಿಸಿ, ಮನರಂಜನೆ ಮತ್ತು ಚಿಂತನೆಗಾಗಿ ನಿಮ್ಮ ಭಾಷೆಯಲ್ಲಿ ಸಾಂಪ್ರದಾಯಿಕ ಹಸ್ತಸಾಮುದ್ರಿಕದ ಪ್ರಕಾರ ಅವುಗಳನ್ನು ವಿವರಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅରା ପାମ ଫଟୋରୁ ଆପଣଙ୍କ ପାପୁଲିର ମୁଖ୍ୟ ରେଖା ଖୋଜେ ଏବଂ ମନୋରଞ୍ଜନ ଓ ଚିନ୍ତନ ପାଇଁ ଆପଣଙ୍କ ଭାଷାରେ ପାରମ୍ପରିକ ହସ୍ତରେଖା ଶାସ୍ତ୍ର ଅନୁସାରେ ସେଗୁଡ଼ିକର ବ୍ୟାଖ୍ୟା କରେ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓറ പാം ഫോട്ടോയിൽ നിന്ന് നിങ്ങളുടെ കൈപ്പത്തിയിലെ പ്രധാന രേഖകൾ കണ്ടെത്തി, വിനോദത്തിനും ചിന്തയ്ക്കുമായി നിങ്ങളുടെ ഭാഷയിൽ പരമ്പരാഗത ഹസ്തരേഖാ ശാസ്ത്രമനുസരിച്ച് അവ വിശദീകരിക്കുന്നു."
          }
        }
      }
    },
