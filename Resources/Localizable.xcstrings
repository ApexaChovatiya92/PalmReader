    "handShape.indexRing.equal.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jupiter and Apollo in balance: traditionally a blend of ambition and creativity with an even temperament."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरु और सूर्य संतुलन में: परंपरागत रूप से महत्वाकांक्षा और रचनात्मकता का मेल, संतुलित स्वभाव के साथ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বৃহস্পতি ও রবি ভারসাম্যে: ঐতিহ্যগতভাবে উচ্চাকাঙ্ক্ষা ও সৃজনশীলতার মেলবন্ধন, সুষম মেজাজসহ।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरू आणि रवी समतोलात: परंपरेनुसार महत्त्वाकांक्षा आणि सर्जनशीलतेचा मेळ, संतुलित स्वभावासह."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గురు మరియు సూర్యుడు సమతుల్యంలో: సంప్రదాయంగా ఆకాంక్ష మరియు సృజనాత్మకతల మేళవింపు, సమతుల్య స్వభావంతో."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குருவும் சூரியனும் சமநிலையில்: மரபுப்படி லட்சியமும் படைப்பாற்றலும் கலந்த, சமநிலையான மனநிலை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગુરુ અને સૂર્ય સંતુલનમાં: પરંપરાગત રીતે મહત્વાકાંક્ષા અને સર્જનાત્મકતાનો મેળ, સંતુલિત સ્વભાવ સાથે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشتری اور شمس توازن میں: روایتی طور پر عزائم اور تخلیقیت کا امتزاج، متوازن مزاج کے ساتھ۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುರು ಮತ್ತು ಸೂರ್ಯ ಸಮತೋಲನದಲ್ಲಿ: ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಮಹತ್ವಾಕಾಂಕ್ಷೆ ಮತ್ತು ಸೃಜನಶೀಲತೆಯ ಮಿಶ್ರಣ, ಸಮಚಿತ್ತದೊಂದಿಗೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୁରୁ ଓ ସୂର୍ଯ୍ୟ ସନ୍ତୁଳନରେ: ପରମ୍ପରା ଅନୁସାରେ ଉଚ୍ଚାକାଂକ୍ଷା ଓ ସୃଜନଶୀଳତାର ମିଶ୍ରଣ, ସନ୍ତୁଳିତ ସ୍ୱଭାବ ସହ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗുരുവും സൂര്യനും സന്തുലനത്തിൽ: പരമ്പരാഗതമായി അഭിലാഷവും സർഗാത്മകതയും ചേർന്ന, സമചിത്തമായ സ്വഭാവം."
          }
        }
      }
    },
    "handShape.indexRing.index": {
