    "element.air": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Hand"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वायु हस्त"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বায়ু হস্ত"
          }
        },
        "mr": {
          "stringUnit": {
