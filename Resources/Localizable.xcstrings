        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ભાવનાત્મક ગરિમા"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جذباتی وقار"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಭಾವನಾತ್ಮಕ ಘನತೆ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭାବନାତ୍ମକ ମର୍ଯ୍ୟାଦା"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൈകാരിക ഔന്നത്യം"
          }
        }
      }
    },
    "heart.warm.advice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice regular self-care rituals so your giving nature does not leave your own emotional cup depleted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित आत्म-देखभाल करें ताकि आपका देने वाला स्वभाव आपको भावनात्मक रूप से खाली न कर दे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিয়মিত নিজের যত্ন নিন, যাতে আপনার দেওয়ার স্বভাব আপনাকে আবেগের দিক থেকে নিঃশেষ না করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित स्वतःची काळजी घ्या, जेणेकरून तुमचा देण्याचा स्वभाव तुम्हाला भावनिकदृष्ट्या रिकामे करणार नाही."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్రమం తప్పకుండా స్వీయ సంరక్షణ చేసుకోండి, తద్వారా మీ ఇచ్చే స్వభావం మిమ్మల్ని భావోద్వేగపరంగా ఖాళీ చేయదు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்ந்து சுயபராமரிப்பு செய்யுங்கள்; அப்போதுதான் உங்கள் கொடுக்கும் இயல்பு உங்களை உணர்வுரீதியாக வெறுமையாக்காது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિયમિત સ્વ-સંભાળ રાખો જેથી તમારો આપવાનો સ્વભાવ તમને ભાવનાત્મક રીતે ખાલી ન કરી દે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقاعدگی سے اپنا خیال رکھیں تاکہ آپ کی دینے والی فطرت آپ کو جذباتی طور پر خالی نہ کر دے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಯಮಿತವಾಗಿ ಸ್ವ-ಆರೈಕೆ ಮಾಡಿಕೊಳ್ಳಿ, ಆಗ ನಿಮ್ಮ ಕೊಡುವ ಸ್ವಭಾವ ನಿಮ್ಮನ್ನು ಭಾವನಾತ್ಮಕವಾಗಿ ಬರಿದಾಗಿಸುವುದಿಲ್ಲ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିୟମିତ ଆତ୍ମଯତ୍ନ ନିଅନ୍ତୁ, ଯାହାଦ୍ୱାରା ଆପଣଙ୍କ ଦେବା ସ୍ୱଭାବ ଆପଣଙ୍କୁ ଭାବନାତ୍ମକ ଭାବେ ଶୂନ୍ୟ କରିଦେବ ନାହିଁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പതിവായി സ്വയം പരിചരണം നടത്തുക, അങ്ങനെ നിങ്ങളുടെ കൊടുക്കുന്ന സ്വഭാവം നിങ്ങളെ വൈകാരികമായി ശൂന്യമാക്കില്ല."
          }
        }
      }
    },
    "heart.warm.detailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You express your feelings naturally and intuitively. You form connections effortlessly and bring harmony to group dynamics through empathetic listening."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपनी भावनाएँ स्वाभाविक और सहज रूप से व्यक्त करते हैं। आप आसानी से संबंध बनाते हैं और सहानुभूतिपूर्ण ढंग से सुनकर समूह में सामंजस्य लाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি নিজের অনুভূতি স্বাভাবিক ও সহজভাবে প্রকাশ করেন। আপনি অনায়াসে সম্পর্ক গড়েন এবং সহমর্মী শ্রবণের মাধ্যমে দলে সামঞ্জস্য আনেন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तुमच्या भावना नैसर्गिकपणे आणि सहजपणे व्यक्त करता. तुम्ही सहज नाती जोडता आणि सहानुभूतीपूर्वक ऐकून गटात सुसंवाद आणता."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మీ భావాలను సహజంగా మరియు అంతర్బుద్ధితో వ్యక్తపరుస్తారు. మీరు సులభంగా అనుబంధాలు ఏర్పరుస్తారు మరియు సానుభూతితో వినడం ద్వారా బృందంలో సామరస్యాన్ని తీసుకొస్తారు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உங்கள் உணர்வுகளை இயல்பாகவும் உள்ளுணர்வுடனும் வெளிப்படுத்துகிறீர்கள். நீங்கள் எளிதாக உறவுகளை உருவாக்குகிறீர்கள்; பரிவுடன் கேட்பதன் மூலம் குழுவில் இணக்கத்தைக் கொண்டு வருகிறீர்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે તમારી લાગણીઓ સ્વાભાવિક અને સહજ રીતે વ્યક્ત કરો છો. તમે સરળતાથી સંબંધો બાંધો છો અને સહાનુભૂતિપૂર્વક સાંભળીને જૂથમાં સુમેળ લાવો છો."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنے جذبات فطری اور بے ساختہ انداز میں ظاہر کرتے ہیں۔ آپ آسانی سے تعلق بناتے ہیں اور ہمدردی سے سن کر گروہ میں ہم آہنگی لاتے ہیں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿಮ್ಮ ಭಾವನೆಗಳನ್ನು ಸಹಜವಾಗಿ ಮತ್ತು ಅಂತಃಪ್ರಜ್ಞೆಯಿಂದ ವ್ಯಕ್ತಪಡಿಸುತ್ತೀರಿ. ನೀವು ಸುಲಭವಾಗಿ ಬಾಂಧವ್ಯ ಬೆಳೆಸುತ್ತೀರಿ ಮತ್ತು ಸಹಾನುಭೂತಿಯಿಂದ ಆಲಿಸುವ ಮೂಲಕ ಗುಂಪಿನಲ್ಲಿ ಸಾಮರಸ್ಯವನ್ನು ತರುತ್ತೀರಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ନିଜ ଭାବନାକୁ ସ୍ୱାଭାବିକ ଓ ସହଜ ଭାବେ ପ୍ରକାଶ କରନ୍ତି। ଆପଣ ସହଜରେ ସମ୍ପର୍କ ଗଢ଼ନ୍ତି ଏବଂ ସହାନୁଭୂତିର ସହ ଶୁଣି ଦଳରେ ସମନ୍ୱୟ ଆଣନ୍ତି।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ നിങ്ങളുടെ വികാരങ്ങൾ സ്വാഭാവികമായും സഹജമായും പ്രകടിപ്പിക്കുന്നു. നിങ്ങൾ എളുപ്പത്തിൽ ബന്ധങ്ങൾ സ്ഥാപിക്കുകയും സഹാനുഭൂതിയോടെ കേൾക്കുന്നതിലൂടെ കൂട്ടായ്മയിൽ യോജിപ്പ് കൊണ്ടുവരികയും ചെയ്യുന്നു."
          }
        }
      }
    },
    "heart.warm.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle curve highlights genuine emotional transparency, spontaneous warmth, and compassionate communication."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कोमल वक्र सच्ची भावनात्मक पारदर्शिता, सहज आत्मीयता और करुणापूर्ण संवाद को उजागर करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কোমল বাঁক আন্তরিক আবেগের স্বচ্ছতা, স্বতঃস্ফূর্ত উষ্ণতা ও সহানুভূতিশীল যোগাযোগ তুলে ধরে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सौम्य वक्र खरी भावनिक पारदर्शकता, उत्स्फूर्त आपुलकी आणि करुणामय संवाद दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మృదువైన వంపు నిజమైన భావోద్వేగ పారదర్శకత, సహజమైన ఆప్యాయత మరియు కరుణతో కూడిన సంభాషణను చూపిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மென்மையான வளைவு உண்மையான உணர்வு வெளிப்படைத்தன்மை, இயல்பான அரவணைப்பு மற்றும் இரக்கமுள்ள உரையாடலை வெளிப்படுத்துகிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક કોમળ વળાંક સાચી ભાવનાત્મક પારદર્શિતા, સહજ હૂંફ અને કરુણાપૂર્ણ સંવાદ દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نرم خم سچی جذباتی شفافیت، بے ساختہ گرم جوشی اور ہمدردانہ گفتگو کو نمایاں کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೃದುವಾದ ಬಾಗು ನಿಜವಾದ ಭಾವನಾತ್ಮಕ ಪಾರದರ್ಶಕತೆ, ಸಹಜ ಆತ್ಮೀಯತೆ ಮತ್ತು ಕರುಣಾಮಯ ಸಂವಹನವನ್ನು ಎತ್ತಿ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ କୋମଳ ବାଙ୍କ ପ୍ରକୃତ ଭାବନାତ୍ମକ ସ୍ୱଚ୍ଛତା, ସ୍ୱତଃସ୍ଫୂର୍ତ୍ତ ଆନ୍ତରିକତା ଓ କରୁଣାପୂର୍ଣ୍ଣ ଯୋଗାଯୋଗକୁ ଉଜ୍ଜ୍ୱଳ କରେ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൃദുവായ വളവ് യഥാർത്ഥ വൈകാരിക സുതാര്യത, സ്വാഭാവിക ഊഷ്മളത, കാരുണ്യമുള്ള ആശയവിനിമയം എന്നിവ എടുത്തുകാട്ടുന്നു."
          }
        }
      }
    },
    "heart.warm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm & Expressive Affection"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आत्मीय और अभिव्यक्तिपूर्ण स्नेह"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উষ্ণ ও প্রকাশমুখর স্নেহ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपुलकीचा आणि व्यक्त स्नेह"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆప్యాయమైన మరియు వ్యక్తీకరణాత్మక ప్రేమ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அன்பான மற்றும் வெளிப்படையான பாசம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હૂંફાળો અને અભિવ્યક્ત સ્નેહ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گرم جوش اور اظہار بھری محبت"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆತ್ಮೀಯ ಮತ್ತು ಅಭಿವ್ಯಕ್ತ ಪ್ರೀತಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆନ୍ତରିକ ଓ ପ୍ରକାଶଶୀଳ ସ୍ନେହ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഊഷ്മളവും പ്രകടവുമായ സ്നേഹം"
          }
        }
      }
    },
    "heart.warm.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empathetic"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहानुभूतिशील"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহমর্মী"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहानुभूतीशील"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సానుభూతిపరులు"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிவுள்ளவர்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સહાનુભૂતિશીલ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمدرد"
          }
        },
        "kn": {
