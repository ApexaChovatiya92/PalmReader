    "mount.saturn.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanced Saturn indicates thoughtful introspection, depth of insight, and enduring patience with complex challenges."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संतुलित शनि पर्वत विचारशील आत्मचिंतन, गहरी अंतर्दृष्टि और जटिल चुनौतियों के प्रति स्थायी धैर्य दर्शाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভারসাম্যপূর্ণ শনি পর্বত চিন্তাশীল আত্মবিশ্লেষণ, গভীর অন্তর্দৃষ্টি এবং জটিল চ্যালেঞ্জে দীর্ঘস্থায়ী ধৈর্য নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संतुलित शनी पर्वत विचारपूर्वक आत्मचिंतन, सखोल अंतर्दृष्टी आणि गुंतागुंतीच्या आव्हानांसमोर टिकाऊ संयम दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమతుల్యమైన శని పర్వతం ఆలోచనాత్మక ఆత్మపరిశీలన, లోతైన అంతర్దృష్టి మరియు క్లిష్టమైన సవాళ్లపై స్థిరమైన ఓర్పును సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமநிலையான சனி மேடு சிந்தனைமிக்க சுயபரிசோதனை, ஆழ்ந்த உள்நோக்கு மற்றும் சிக்கலான சவால்களில் நிலையான பொறுமையைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંતુલિત શનિ પર્વત વિચારશીલ આત્મચિંતન, ઊંડી અંતર્દૃષ્ટિ અને જટિલ પડકારો સામે સ્થાયી ધીરજ દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متوازن زحل کا ابھار سوچی سمجھی خود شناسی، گہری بصیرت اور پیچیدہ چیلنجوں میں دیرپا صبر ظاہر کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮತೋಲಿತ ಶನಿ ಪರ್ವತವು ಚಿಂತನಶೀಲ ಆತ್ಮಾವಲೋಕನ, ಆಳವಾದ ಒಳನೋಟ ಮತ್ತು ಸಂಕೀರ್ಣ ಸವಾಲುಗಳಲ್ಲಿ ಸ್ಥಿರ ತಾಳ್ಮೆಯನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସନ୍ତୁଳିତ ଶନି ପର୍ବତ ଚିନ୍ତାଶୀଳ ଆତ୍ମସମୀକ୍ଷା, ଗଭୀର ଅନ୍ତର୍ଦୃଷ୍ଟି ଓ ଜଟିଳ ଆହ୍ୱାନରେ ସ୍ଥାୟୀ ଧୈର୍ଯ୍ୟ ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സന്തുലിതമായ ശനി പർവ്വതം ചിന്താപൂർവമായ ആത്മപരിശോധന, ആഴമുള്ള ഉൾക്കാഴ്ച, സങ്കീർണ വെല്ലുവിളികളിൽ സ്ഥിരമായ ക്ഷമ എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
