    "guidance.moveBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move hand slightly further back"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथ को थोड़ा पीछे ले जाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাতটি একটু পিছিয়ে নিন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हात थोडा मागे न्या"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేయిని కొంచెం వెనక్కి జరపండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கையைச் சற்றுப் பின்னால் நகர்த்தவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને થોડો પાછળ લઈ જાઓ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاتھ کو تھوڑا پیچھے لے جائیں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೈಯನ್ನು ಸ್ವಲ್ಪ ಹಿಂದಕ್ಕೆ ಸರಿಸಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହାତକୁ ଟିକେ ପଛକୁ ନିଅନ୍ତୁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൈ അൽപ്പം പിന്നിലേക്ക് നീക്കുക"
          }
        }
      }
    },
    "guidance.moveCloser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move your hand a bit closer to the camera"
          }
        },
        "hi": {
          "stringUnit": {
