    "insight.reflection.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's currents encourage balance between thoughtful deliberation and decisive execution. Trust the natural wisdom etched into your palms and navigate conversations with clarity."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की ऊर्जा सोच-समझकर विचार करने और दृढ़ता से कार्य करने के बीच संतुलन को प्रोत्साहित करती है। अपनी हथेलियों में अंकित स्वाभाविक ज्ञान पर भरोसा करें और स्पष्टता के साथ बातचीत करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের স্রোত চিন্তাশীল বিবেচনা ও দৃঢ় কাজের মধ্যে ভারসাম্যকে উৎসাহিত করে। আপনার তালুতে খোদিত স্বাভাবিক প্রজ্ঞায় আস্থা রাখুন এবং স্বচ্ছতার সঙ্গে কথা বলুন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजची ऊर्जा विचारपूर्वक चिंतन आणि निर्णायक कृती यांच्यातील समतोलाला प्रोत्साहन देते. तुमच्या तळहातावर कोरलेल्या नैसर्गिक शहाणपणावर विश्वास ठेवा आणि स्पष्टपणे संवाद साधा."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేటి ప్రవాహాలు ఆలోచనాత్మక పరిశీలన మరియు నిర్ణయాత్మక ఆచరణ మధ్య సమతుల్యతను ప్రోత్సహిస్తాయి. మీ అరచేతులపై చెక్కబడిన సహజ జ్ఞానాన్ని నమ్మండి మరియు స్పష్టతతో సంభాషించండి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய ஓட்டங்கள் சிந்தனைமிக்க ஆலோசனைக்கும் உறுதியான செயலுக்கும் இடையிலான சமநிலையை ஊக்குவிக்கின்றன. உங்கள் உள்ளங்கைகளில் பொறிக்கப்பட்ட இயற்கை ஞானத்தை நம்புங்கள்; தெளிவுடன் உரையாடுங்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજની ઊર્જા વિચારપૂર્વક મનન અને નિર્ણાયક અમલ વચ્ચે સંતુલનને પ્રોત્સાહન આપે છે. તમારી હથેળીમાં અંકિત કુદરતી જ્ઞાન પર વિશ્વાસ રાખો અને સ્પષ્ટતા સાથે વાતચીત કરો."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی لہریں سوچ سمجھ کر غور کرنے اور فیصلہ کن عمل کے درمیان توازن کی حوصلہ افزائی کرتی ہیں۔ اپنی ہتھیلیوں پر کندہ فطری دانائی پر بھروسہ کریں اور وضاحت کے ساتھ گفتگو کریں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದಿನ ಹರಿವು ಚಿಂತನಶೀಲ ವಿವೇಚನೆ ಮತ್ತು ದೃಢ ಕಾರ್ಯಾಚರಣೆಯ ನಡುವಿನ ಸಮತೋಲನವನ್ನು ಉತ್ತೇಜಿಸುತ್ತದೆ. ನಿಮ್ಮ ಅಂಗೈಗಳಲ್ಲಿ ಕೆತ್ತಲಾದ ಸಹಜ ಜ್ಞಾನವನ್ನು ನಂಬಿ ಮತ್ತು ಸ್ಪಷ್ಟತೆಯಿಂದ ಸಂವಾದ ನಡೆಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜିର ପ୍ରବାହ ଚିନ୍ତାଶୀଳ ବିଚାର ଓ ନିର୍ଣ୍ଣାୟକ କାର୍ଯ୍ୟ ମଧ୍ୟରେ ସନ୍ତୁଳନକୁ ପ୍ରୋତ୍ସାହିତ କରେ। ଆପଣଙ୍କ ପାପୁଲିରେ ଅଙ୍କିତ ସ୍ୱାଭାବିକ ଜ୍ଞାନ ଉପରେ ଭରସା ରଖନ୍ତୁ ଏବଂ ସ୍ପଷ୍ଟତା ସହ କଥାବାର୍ତ୍ତା କରନ୍ତୁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ പ്രവാഹങ്ങൾ ചിന്താപൂർവമായ ആലോചനയ്ക്കും നിർണായക പ്രവർത്തനത്തിനും ഇടയിലുള്ള സന്തുലനത്തെ പ്രോത്സാഹിപ്പിക്കുന്നു. നിങ്ങളുടെ കൈപ്പത്തികളിൽ കൊത്തിയ സ്വാഭാവിക ജ്ഞാനത്തിൽ വിശ്വസിക്കുക, വ്യക്തതയോടെ സംസാരിക്കുക."
          }
        }
      }
    },
    "insight.reflection.header": {
