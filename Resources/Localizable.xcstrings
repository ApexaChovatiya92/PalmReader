      }
    },
    "mount.venus.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich Venus mount reflects abundant love for life, warmth in relationships, physical vitality, and deep capacity for joy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समृद्ध शुक्र पर्वत जीवन के प्रति भरपूर प्रेम, संबंधों में आत्मीयता, शारीरिक जीवनशक्ति और आनंद की गहरी क्षमता दर्शाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমৃদ্ধ শুক্র পর্বত জীবনের প্রতি গভীর ভালোবাসা, সম্পর্কে উষ্ণতা, শারীরিক প্রাণশক্তি ও আনন্দের গভীর ক্ষমতা প্রতিফলিত করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समृद्ध शुक्र पर्वत जीवनावरील भरभरून प्रेम, नात्यांतील आपुलकी, शारीरिक चैतन्य आणि आनंदाची सखोल क्षमता दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమృద్ధమైన శుక్ర పర్వతం జీవితంపై అపారమైన ప్రేమ, సంబంధాలలో ఆప్యాయత, శారీరక జీవశక్తి మరియు ఆనందించే లోతైన సామర్థ్యాన్ని ప్రతిబింబిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செழிப்பான சுக்கிர மேடு வாழ்க்கையின் மீதான நிறைந்த அன்பு, உறவுகளில் அரவணைப்பு, உடல் உயிர்ச்சக்தி மற்றும் மகிழ்ச்சிக்கான ஆழ்ந்த திறனைப் பிரதிபலிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમૃદ્ધ શુક્ર પર્વત જીવન પ્રત્યે ભરપૂર પ્રેમ, સંબંધોમાં હૂંફ, શારીરિક જીવનશક્તિ અને આનંદની ઊંડી ક્ષમતા દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھرپور زہرہ کا ابھار زندگی سے گہری محبت، رشتوں میں گرم جوشی، جسمانی توانائی اور خوشی کی گہری صلاحیت ظاہر کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮೃದ್ಧ ಶುಕ್ರ ಪರ್ವತವು ಜೀವನದ ಮೇಲಿನ ಅಪಾರ ಪ್ರೀತಿ, ಸಂಬಂಧಗಳಲ್ಲಿ ಆತ್ಮೀಯತೆ, ದೈಹಿಕ ಜೀವಶಕ್ತಿ ಮತ್ತು ಆನಂದದ ಆಳವಾದ ಸಾಮರ್ಥ್ಯವನ್ನು ಪ್ರತಿಬಿಂಬಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମୃଦ୍ଧ ଶୁକ୍ର ପର୍ବତ ଜୀବନ ପ୍ରତି ଗଭୀର ପ୍ରେମ, ସମ୍ପର୍କରେ ଆନ୍ତରିକତା, ଶାରୀରିକ ଜୀବନୀଶକ୍ତି ଓ ଆନନ୍ଦର ଗଭୀର କ୍ଷମତା ଦର୍ଶାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമൃദ്ധമായ ശുക്ര പർവ്വതം ജീവിതത്തോടുള്ള നിറഞ്ഞ സ്നേഹം, ബന്ധങ്ങളിലെ ഊഷ്മളത, ശാരീരിക ജീവശക്തി, ആനന്ദിക്കാനുള്ള ആഴമുള്ള കഴിവ് എന്നിവ പ്രതിഫലിപ്പിക്കുന്നു."
          }
        }
      }
    },
    "mounts.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
