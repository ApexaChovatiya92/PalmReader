    "head.analytical.advice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite moments of unstructured brainstorming and playful spontaneity to balance your analytical brilliance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी विश्लेषणात्मक प्रतिभा को संतुलित करने के लिए खुले विचार-मंथन और सहज चंचलता के क्षण भी अपनाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিশ্লেষণী প্রতিভার ভারসাম্য রাখতে মুক্ত ভাবনা ও খেলাচ্ছলে স্বতঃস্ফূর্ততার মুহূর্তও উপভোগ করুন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या विश्लेषणात्मक प्रतिभेला समतोल देण्यासाठी मुक्त विचारमंथन आणि खेळकर उत्स्फूर्ततेचे क्षणही अनुभवा."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ విశ్లేషణాత్మక ప్రతిభను సమతుల్యం చేయడానికి స్వేచ్ఛాయుత ఆలోచనా మథనం మరియు సరదా సహజత్వపు క్షణాలను కూడా ఆహ్వానించండి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பகுப்பாய்வுத் திறமையைச் சமநிலைப்படுத்த, கட்டற்ற சிந்தனைக்கும் விளையாட்டான இயல்புக்குமான தருணங்களையும் வரவேற்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી વિશ્લેષણાત્મક પ્રતિભાને સંતુલિત કરવા મુક્ત વિચાર-મંથન અને સહજ રમતિયાળપણાની ક્ષણો પણ અપનાવો."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی تجزیاتی صلاحیت کو متوازن رکھنے کے لیے آزاد ذہن سازی اور شگفتہ بے ساختگی کے لمحات بھی اپنائیں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವಿಶ್ಲೇಷಣಾತ್ಮಕ ಪ್ರತಿಭೆಯನ್ನು ಸಮತೋಲನಗೊಳಿಸಲು ಮುಕ್ತ ಚಿಂತನ-ಮಂಥನ ಮತ್ತು ತಮಾಷೆಯ ಸಹಜತೆಯ ಕ್ಷಣಗಳನ್ನೂ ಸ್ವಾಗತಿಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବିଶ୍ଳେଷଣାତ୍ମକ ପ୍ରତିଭାକୁ ସନ୍ତୁଳିତ କରିବା ପାଇଁ ମୁକ୍ତ ଚିନ୍ତାମନ୍ଥନ ଓ ଖେଳାଳି ସ୍ୱତଃସ୍ଫୂର୍ତ୍ତତାର ମୁହୂର୍ତ୍ତ ମଧ୍ୟ ଆପଣାନ୍ତୁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വിശകലന പ്രതിഭയെ സന്തുലിതമാക്കാൻ സ്വതന്ത്രമായ ആശയചർച്ചയുടെയും കളിയായ സ്വാഭാവികതയുടെയും നിമിഷങ്ങളെയും സ്വാഗതം ചെയ്യുക."
          }
        }
      }
    },
    "head.analytical.detailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cut through complexity with clarity and evidence. You prefer structured reasoning, measurable facts, and actionable reality. In high-stakes moments, your mind remains composed, analyzing variables without emotional overwhelm."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप स्पष्टता और प्रमाण के साथ जटिलता को सुलझाते हैं। आप संरचित तर्क, मापने योग्य तथ्य और व्यावहारिक यथार्थ पसंद करते हैं। महत्वपूर्ण क्षणों में आपका मन शांत रहता है और भावनाओं में बहे बिना परिस्थितियों का विश्लेषण करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি স্বচ্ছতা ও প্রমাণের সাহায্যে জটিলতা ভেদ করেন। আপনি কাঠামোবদ্ধ যুক্তি, পরিমাপযোগ্য তথ্য ও বাস্তবসম্মত সত্য পছন্দ করেন। গুরুত্বপূর্ণ মুহূর্তে আপনার মন শান্ত থাকে এবং আবেগে ভেসে না গিয়ে পরিস্থিতি বিশ্লেষণ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही स्पष्टता आणि पुराव्यांच्या आधारे गुंतागुंत सोडवता. तुम्हाला सुव्यवस्थित तर्क, मोजता येणारी तथ्ये आणि कृतीयोग्य वास्तव आवडते. महत्त्वाच्या क्षणी तुमचे मन शांत राहते आणि भावनांच्या आहारी न जाता परिस्थितीचे विश्लेषण करते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు స్పష్టత మరియు ఆధారాలతో సంక్లిష్టతను ఛేదిస్తారు. మీరు క్రమబద్ధమైన తర్కం, కొలవగల వాస్తవాలు మరియు ఆచరణీయమైన వాస్తవికతను ఇష్టపడతారు. కీలక క్షణాలలో మీ మనస్సు ప్రశాంతంగా ఉండి, భావోద్వేగాలకు లోనవకుండా పరిస్థితులను విశ్లేషిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தெளிவு மற்றும் ஆதாரங்களுடன் நீங்கள் சிக்கல்களைத் தீர்க்கிறீர்கள். ஒழுங்கான தர்க்கம், அளவிடக்கூடிய உண்மைகள் மற்றும் செயல்படுத்தக்கூடிய யதார்த்தத்தை விரும்புகிறீர்கள். முக்கியமான தருணங்களில் உங்கள் மனம் அமைதியாக இருந்து, உணர்ச்சிவசப்படாமல் சூழலைப் பகுப்பாய்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સ્પષ્ટતા અને પુરાવા સાથે જટિલતાને ઉકેલો છો. તમે માળખાગત તર્ક, માપી શકાય તેવાં તથ્યો અને વ્યવહારુ વાસ્તવિકતા પસંદ કરો છો. મહત્વના સમયે તમારું મન શાંત રહે છે અને લાગણીઓમાં વહ્યા વિના પરિસ્થિતિનું વિશ્લેષણ કરે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ وضاحت اور ثبوت کے ساتھ پیچیدگی کو حل کرتے ہیں۔ آپ منظم استدلال، قابلِ پیمائش حقائق اور عملی حقیقت پسند کرتے ہیں۔ اہم لمحات میں آپ کا ذہن پرسکون رہتا ہے اور جذبات میں بہے بغیر حالات کا تجزیہ کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸ್ಪಷ್ಟತೆ ಮತ್ತು ಪುರಾವೆಗಳೊಂದಿಗೆ ಸಂಕೀರ್ಣತೆಯನ್ನು ಭೇದಿಸುತ್ತೀರಿ. ನೀವು ವ್ಯವಸ್ಥಿತ ತರ್ಕ, ಅಳೆಯಬಹುದಾದ ಸತ್ಯಗಳು ಮತ್ತು ಕಾರ್ಯಸಾಧ್ಯ ವಾಸ್ತವವನ್ನು ಇಷ್ಟಪಡುತ್ತೀರಿ. ನಿರ್ಣಾಯಕ ಕ್ಷಣಗಳಲ್ಲಿ ನಿಮ್ಮ ಮನಸ್ಸು ಶಾಂತವಾಗಿದ್ದು, ಭಾವನೆಗಳಿಗೆ ಒಳಗಾಗದೆ ಸನ್ನಿವೇಶವನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ସ୍ପଷ୍ଟତା ଓ ପ୍ରମାଣ ସହ ଜଟିଳତାକୁ ସମାଧାନ କରନ୍ତି। ଆପଣ ସଂରଚିତ ତର୍କ, ମାପଯୋଗ୍ୟ ତଥ୍ୟ ଓ ବ୍ୟାବହାରିକ ବାସ୍ତବତା ପସନ୍ଦ କରନ୍ତି। ଗୁରୁତ୍ୱପୂର୍ଣ୍ଣ ମୁହୂର୍ତ୍ତରେ ଆପଣଙ୍କ ମନ ଶାନ୍ତ ରହେ ଏବଂ ଭାବନାରେ ନ ଭାସି ପରିସ୍ଥିତିର ବିଶ୍ଳେଷଣ କରେ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യക്തതയോടെയും തെളിവുകളോടെയും നിങ്ങൾ സങ്കീർണതയെ മറികടക്കുന്നു. ചിട്ടയായ യുക്തി, അളക്കാവുന്ന വസ്തുതകൾ, പ്രായോഗിക യാഥാർത്ഥ്യം എന്നിവ നിങ്ങൾ ഇഷ്ടപ്പെടുന്നു. നിർണായക നിമിഷങ്ങളിൽ നിങ്ങളുടെ മനസ്സ് ശാന്തമായി നിന്ന്, വികാരങ്ങൾക്ക് അടിപ്പെടാതെ സാഹചര്യങ്ങൾ വിശകലനം ചെയ്യുന്നു."
          }
        }
      }
    },
    "head.analytical.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A direct, horizontal trajectory signifies methodical intellect, objectivity, and crystalline discernment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधी, क्षैतिज रेखा व्यवस्थित बुद्धि, निष्पक्षता और स्पष्ट विवेक का संकेत है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোজা, অনুভূমিক রেখা পদ্ধতিগত বুদ্ধি, বস্তুনিষ্ঠতা ও স্বচ্ছ বিচারবোধ নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सरळ, आडवी रेषा पद्धतशीर बुद्धी, वस्तुनिष्ठता आणि स्फटिकासारखा स्पष्ट विवेक दर्शवते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేరుగా, అడ్డంగా సాగే రేఖ పద్ధతిగల బుద్ధి, నిష్పాక్షికత మరియు స్ఫటికంలా స్పష్టమైన వివేకాన్ని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரான, கிடைமட்டப் பாதை முறையான அறிவு, புறநிலை மற்றும் படிகம் போன்ற தெளிவான விவேகத்தைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સીધી, આડી રેખા વ્યવસ્થિત બુદ્ધિ, નિષ્પક્ષતા અને સ્પષ્ટ વિવેકનો સંકેત છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیدھی، افقی لکیر منظم ذہانت، غیر جانبداری اور شفاف دانشمندی کی علامت ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೇರ, ಅಡ್ಡಲಾದ ಪಥವು ಕ್ರಮಬದ್ಧ ಬುದ್ಧಿ, ವಸ್ತುನಿಷ್ಠತೆ ಮತ್ತು ಸ್ಫಟಿಕದಂತೆ ಸ್ಪಷ್ಟ ವಿವೇಚನೆಯನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସିଧା, ଭୂସମାନ୍ତର ରେଖା ପଦ୍ଧତିଗତ ବୁଦ୍ଧି, ନିରପେକ୍ଷତା ଓ ସ୍ୱଚ୍ଛ ବିବେକ ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നേരായ, തിരശ്ചീനമായ പാത ചിട്ടയായ ബുദ്ധി, വസ്തുനിഷ്ഠത, സ്ഫടികം പോലെ വ്യക്തമായ വിവേകം എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
    "head.analytical.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategic & Analytical Precision"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रणनीतिक और विश्लेषणात्मक सटीकता"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কৌশলগত ও বিশ্লেষণী নির্ভুলতা"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "धोरणात्मक आणि विश्लेषणात्मक अचूकता"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యూహాత్మక మరియు విశ్లేషణాత్మక ఖచ్చితత్వం"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உத்திசார் மற்றும் பகுப்பாய்வுத் துல்லியம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વ્યૂહાત્મક અને વિશ્લેષણાત્મક ચોકસાઈ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حکمتِ عملی اور تجزیاتی درستی"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾರ್ಯತಂತ್ರದ ಮತ್ತು ವಿಶ್ಲೇಷಣಾತ್ಮಕ ನಿಖರತೆ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କୌଶଳଗତ ଓ ବିଶ୍ଳେଷଣାତ୍ମକ ସଠିକତା"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
