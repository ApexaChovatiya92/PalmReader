        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हात कॅमेऱ्याच्या थोडा जवळ आणा"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేయిని కెమెరాకు కొంచెం దగ్గరగా తీసుకురండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கையை கேமராவுக்குச் சற்று அருகில் கொண்டு வரவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને કૅમેરાની થોડો નજીક લાવો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاتھ کو کیمرے کے تھوڑا قریب لائیں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೈಯನ್ನು ಕ್ಯಾಮೆರಾಕ್ಕೆ ಸ್ವಲ್ಪ ಹತ್ತಿರ ತನ್ನಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହାତକୁ କ୍ୟାମେରାର ଟିକେ ପାଖକୁ ଆଣନ୍ତୁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൈ ക്യാമറയോട് അൽപ്പം അടുപ്പിക്കുക"
          }
        }
      }
    },
    "guidance.perfect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect alignment! Ready to read..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल सही! पढ़ने के लिए तैयार..."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একদম ঠিক! পাঠের জন্য প্রস্তুত..."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अगदी अचूक! वाचनासाठी तयार..."
          }
