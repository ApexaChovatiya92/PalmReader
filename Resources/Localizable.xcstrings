    "handShape.thumb.long.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionally a sign of strong willpower and determination."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरागत रूप से प्रबल इच्छाशक्ति और दृढ़ संकल्प का संकेत।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐতিহ্যগতভাবে দৃঢ় ইচ্ছাশক্তি ও সংকল্পের চিহ্ন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरेनुसार प्रबळ इच्छाशक्ती आणि दृढनिश्चयाचे चिन्ह."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంప్రదాయంగా బలమైన సంకల్పశక్తి మరియు పట్టుదలకు సంకేతం."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மரபுப்படி வலுவான மன உறுதி மற்றும் விடாமுயற்சியின் அடையாளம்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરંપરાગત રીતે પ્રબળ ઇચ્છાશક્તિ અને દૃઢ નિશ્ચયનો સંકેત."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روایتی طور پر مضبوط قوتِ ارادی اور عزم کی علامت۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಬಲವಾದ ಇಚ್ಛಾಶಕ್ತಿ ಮತ್ತು ದೃಢನಿಶ್ಚಯದ ಸಂಕೇತ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରମ୍ପରା ଅନୁସାରେ ଦୃଢ଼ ଇଚ୍ଛାଶକ୍ତି ଓ ସଂକଳ୍ପର ସଙ୍କେତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമ്പരാഗതമായി ശക്തമായ ഇച്ഛാശക്തിയുടെയും നിശ്ചയദാർഢ്യത്തിന്റെയും ചിഹ്നം."
          }
        }
      }
    },
    "handShape.thumb.short": {
      "extractionState": "manual",
      "localizations": {
