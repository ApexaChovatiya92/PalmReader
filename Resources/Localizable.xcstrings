        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନାମିକାର ଉପର ଗଣ୍ଠି ତଳେ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോതിരവിരലിന്റെ മുകളിലെ സന്ധിക്ക് താഴെ"
          }
        }
      }
    },
    "handShape.little.short.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionally read as someone who shows care through actions more than words."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरागत रूप से ऐसे व्यक्ति के रूप में पढ़ा जाता है जो शब्दों से अधिक कर्मों से परवाह दिखाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐতিহ্যগতভাবে এমন মানুষ হিসেবে পড়া হয় যিনি কথার চেয়ে কাজে যত্ন দেখান।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरेनुसार शब्दांपेक्षा कृतीतून काळजी दाखवणारी व्यक्ती म्हणून वाचले जाते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంప్రదాయంగా మాటల కంటే చేతల ద్వారా శ్రద్ధ చూపే వ్యక్తిగా చదువుతారు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மரபுப்படி சொற்களை விடச் செயல்களால் அக்கறை காட்டுபவராகப் படிக்கப்படுகிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરંપરાગત રીતે એવી વ્યક્તિ તરીકે વાંચવામાં આવે છે જે શબ્દો કરતાં કાર્યોથી કાળજી બતાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روایتی طور پر ایسے شخص کے طور پر پڑھا جاتا ہے جو الفاظ سے زیادہ عمل سے پرواہ دکھاتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಮಾತಿಗಿಂತ ಕೃತಿಯ ಮೂಲಕ ಕಾಳಜಿ ತೋರುವ ವ್ಯಕ್ತಿ ಎಂದು ಓದಲಾಗುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରମ୍ପରା ଅନୁସାରେ ଏପରି ବ୍ୟକ୍ତି ଭାବେ ପଢ଼ାଯାଏ ଯିଏ କଥା ଅପେକ୍ଷା କାମରେ ଯତ୍ନ ଦେଖାନ୍ତି।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമ്പരാഗതമായി വാക്കുകളേക്കാൾ പ്രവൃത്തിയിലൂടെ കരുതൽ കാണിക്കുന്ന വ്യക്തിയായി വായിക്കുന്നു."
          }
        }
      }
    },
    "handShape.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured from the positions of your finger joints in this photo. Meanings are traditional."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो में आपकी उंगलियों के जोड़ों की स्थिति से मापा गया। अर्थ पारंपरिक हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ছবিতে আপনার আঙুলের গাঁটের অবস্থান থেকে মাপা। অর্থগুলো ঐতিহ্যগত।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोटोतील तुमच्या बोटांच्या सांध्यांच्या स्थानांवरून मोजलेले. अर्थ पारंपरिक आहेत."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోలో మీ వేళ్ల కీళ్ల స్థానాల నుండి కొలవబడింది. అర్థాలు సంప్రదాయమైనవి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் படத்தில் உங்கள் விரல் மூட்டுகளின் நிலைகளிலிருந்து அளவிடப்பட்டது. பொருள்கள் பாரம்பரியமானவை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટામાં તમારી આંગળીઓના સાંધાઓની સ્થિતિ પરથી માપેલું. અર્થ પરંપરાગત છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس تصویر میں آپ کی انگلیوں کے جوڑوں کی جگہوں سے ناپا گیا۔ معانی روایتی ہیں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋದಲ್ಲಿನ ನಿಮ್ಮ ಬೆರಳಿನ ಕೀಲುಗಳ ಸ್ಥಾನಗಳಿಂದ ಅಳೆಯಲಾಗಿದೆ. ಅರ್ಥಗಳು ಸಾಂಪ್ರದಾಯಿಕ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫଟୋରେ ଆପଣଙ୍କ ଆଙ୍ଗୁଠି ଗଣ୍ଠିର ସ୍ଥାନରୁ ମାପାଯାଇଛି। ଅର୍ଥଗୁଡ଼ିକ ପାରମ୍ପରିକ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോയിലെ നിങ്ങളുടെ വിരൽ സന്ധികളുടെ സ്ഥാനങ്ങളിൽ നിന്ന് അളന്നത്. അർത്ഥങ്ങൾ പരമ്പരാഗതമാണ്."
          }
        }
      }
    },
