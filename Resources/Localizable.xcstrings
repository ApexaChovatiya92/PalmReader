    "mount.venus.keyword": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitality, Passion & Love"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जीवनशक्ति, जुनून और प्रेम"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাণশক্তি, আবেগ ও প্রেম"
