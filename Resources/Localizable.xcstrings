          }
        }
      }
    },
    "handShape.thumb.short.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionally a sign of an adaptable, easygoing and diplomatic approach."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरागत रूप से लचीले, सहज और कूटनीतिक दृष्टिकोण का संकेत।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐতিহ্যগতভাবে নমনীয়, সহজ ও কূটনৈতিক মনোভাবের চিহ্ন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरेनुसार लवचिक, सहज आणि मुत्सद्दी दृष्टिकोनाचे चिन्ह."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంప్రదాయంగా సర్దుకుపోయే, తేలికగా ఉండే, దౌత్యపరమైన వైఖరికి సంకేతం."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மரபுப்படி நெகிழ்வான, எளிதான, ராஜதந்திர அணுகுமுறையின் அடையாளம்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરંપરાગત રીતે લવચીક, સહજ અને કૂટનીતિક અભિગમનો સંકેત."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روایتی طور پر لچکدار، آسان مزاج اور سفارتی انداز کی علامت۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಹೊಂದಿಕೊಳ್ಳುವ, ಸರಳ ಮತ್ತು ರಾಜತಾಂತ್ರಿಕ ಧೋರಣೆಯ ಸಂಕೇತ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରମ୍ପରା ଅନୁସାରେ ନମନୀୟ, ସହଜ ଓ କୂଟନୈତିକ ଦୃଷ୍ଟିକୋଣର ସଙ୍କେତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമ്പരാഗതമായി വഴക്കമുള്ള, ലളിതമായ, നയതന്ത്രപരമായ സമീപനത്തിന്റെ ചിഹ്നം."
          }
        }
      }
    },
    "head.adaptive.advice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore cross-disciplinary subjects where logic and artistic sense intersect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे विषयों का अन्वेषण करें जहाँ तर्क और कलात्मक समझ एक-दूसरे से मिलते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমন বিষয় অন্বেষণ করুন যেখানে যুক্তি ও শৈল্পিক বোধ একে অপরের সঙ্গে মেলে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जिथे तर्क आणि कलात्मक जाण एकत्र येतात अशा आंतरविद्याशाखीय विषयांचा शोध घ्या."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తర్కం మరియు కళాత్మక అభిరుచి కలిసే అంతర్విభాగ అంశాలను అన్వేషించండి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தர்க்கமும் கலையுணர்வும் சந்திக்கும் பல்துறைப் பாடங்களை ஆராயுங்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એવા વિષયો શોધો જ્યાં તર્ક અને કલાત્મક સમજ એકબીજાને મળે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسے موضوعات تلاش کریں جہاں منطق اور فنی ذوق ایک دوسرے سے ملتے ہیں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತರ್ಕ ಮತ್ತು ಕಲಾತ್ಮಕ ಅಭಿರುಚಿ ಸಂಧಿಸುವ ಅಂತರಶಿಸ್ತೀಯ ವಿಷಯಗಳನ್ನು ಅನ್ವೇಷಿಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପରି ବିଷୟ ଅନ୍ୱେଷଣ କରନ୍ତୁ ଯେଉଁଠି ତର୍କ ଓ କଳାତ୍ମକ ବୋଧ ପରସ୍ପରକୁ ଭେଟନ୍ତି।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "യുക്തിയും കലാബോധവും സന്ധിക്കുന്ന അന്തർവൈജ്ഞാനിക വിഷയങ്ങൾ പര്യവേക്ഷണം ചെയ്യുക."
          }
        }
      }
    },
    "head.adaptive.detailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You possess cognitive flexibility, comfortably shifting between analytical data and intuitive hunches. This makes you an exceptional mediator and creative problem-solver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपमें मानसिक लचीलापन है; आप विश्लेषणात्मक तथ्यों और सहज अनुमानों के बीच आराम से बदलते हैं। यह आपको एक उत्कृष्ट मध्यस्थ और रचनात्मक समस्या-समाधानकर्ता बनाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মধ্যে মানসিক নমনীয়তা আছে; আপনি বিশ্লেষণী তথ্য ও সহজাত অনুমানের মধ্যে স্বচ্ছন্দে বদলান। এটি আপনাকে একজন চমৎকার মধ্যস্থতাকারী ও সৃজনশীল সমস্যা-সমাধানকারী করে তোলে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्यात मानसिक लवचिकता आहे; तुम्ही विश्लेषणात्मक माहिती आणि उपजत अंदाज यांच्यात सहज बदलता. यामुळे तुम्ही उत्तम मध्यस्थ आणि सर्जनशील समस्या-निवारक ठरता."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు మానసిక సరళత ఉంది; మీరు విశ్లేషణాత్మక సమాచారం మరియు సహజమైన అంచనాల మధ్య సులభంగా మారతారు. ఇది మిమ్మల్ని అద్భుతమైన మధ్యవర్తిగా మరియు సృజనాత్మక సమస్య పరిష్కర్తగా చేస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களிடம் மன நெகிழ்வுத்தன்மை உள்ளது; பகுப்பாய்வுத் தரவுக்கும் உள்ளுணர்வு ஊகங்களுக்கும் இடையே நீங்கள் எளிதாக மாறுகிறீர்கள். இது உங்களை சிறந்த மத்தியஸ்தராகவும் படைப்புச் சிக்கல் தீர்ப்பவராகவும் ஆக்குகிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારામાં માનસિક લવચીકતા છે; તમે વિશ્લેષણાત્મક તથ્યો અને સહજ અનુમાનો વચ્ચે સરળતાથી બદલાઓ છો. આ તમને ઉત્તમ મધ્યસ્થી અને સર્જનાત્મક સમસ્યા-ઉકેલક બનાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ میں ذہنی لچک ہے؛ آپ تجزیاتی معلومات اور وجدانی اندازوں کے درمیان آسانی سے بدلتے ہیں۔ یہ آپ کو بہترین ثالث اور تخلیقی مسئلہ حل کرنے والا بناتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮಲ್ಲಿ ಮಾನಸಿಕ ನಮ್ಯತೆ ಇದೆ; ನೀವು ವಿಶ್ಲೇಷಣಾತ್ಮಕ ಮಾಹಿತಿ ಮತ್ತು ಸಹಜ ಊಹೆಗಳ ನಡುವೆ ಸುಲಭವಾಗಿ ಬದಲಾಗುತ್ತೀರಿ. ಇದು ನಿಮ್ಮನ್ನು ಅತ್ಯುತ್ತಮ ಮಧ್ಯಸ್ಥಗಾರ ಮತ್ತು ಸೃಜನಶೀಲ ಸಮಸ್ಯೆ ಪರಿಹಾರಕರನ್ನಾಗಿ ಮಾಡುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ମଧ୍ୟରେ ମାନସିକ ନମନୀୟତା ଅଛି; ଆପଣ ବିଶ୍ଳେଷଣାତ୍ମକ ତଥ୍ୟ ଓ ସହଜ ଅନୁମାନ ମଧ୍ୟରେ ସହଜରେ ବଦଳନ୍ତି। ଏହା ଆପଣଙ୍କୁ ଜଣେ ଉତ୍କୃଷ୍ଟ ମଧ୍ୟସ୍ଥ ଓ ସୃଜନଶୀଳ ସମସ୍ୟା ସମାଧାନକାରୀ କରେ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് മാനസിക വഴക്കമുണ്ട്; വിശകലന വിവരങ്ങൾക്കും സഹജമായ ഊഹങ്ങൾക്കും ഇടയിൽ നിങ്ങൾ എളുപ്പത്തിൽ മാറുന്നു. ഇത് നിങ്ങളെ മികച്ച മധ്യസ്ഥനും സർഗാത്മക പ്രശ്നപരിഹാരകനുമാക്കുന്നു."
          }
        }
      }
    },
    "head.adaptive.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle incline reveals an intellectual balance between practical logic and creative perception."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल्का झुकाव व्यावहारिक तर्क और रचनात्मक दृष्टि के बीच बौद्धिक संतुलन प्रकट करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি হালকা ঢাল ব্যবহারিক যুক্তি ও সৃজনশীল উপলব্ধির মধ্যে বুদ্ধিবৃত্তিক ভারসাম্য প্রকাশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हलका उतार व्यावहारिक तर्क आणि सर्जनशील दृष्टी यांच्यातील बौद्धिक समतोल दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తేలికపాటి వాలు ఆచరణాత్మక తర్కం మరియు సృజనాత్మక గ్రహణ మధ్య మేధో సమతుల్యతను వెల్లడిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மென்மையான சாய்வு நடைமுறைத் தர்க்கத்துக்கும் படைப்புப் பார்வைக்கும் இடையிலான அறிவுச் சமநிலையை வெளிப்படுத்துகிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હળવો ઝુકાવ વ્યવહારુ તર્ક અને સર્જનાત્મક દૃષ્ટિ વચ્ચે બૌદ્ધિક સંતુલન દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہلکا سا جھکاؤ عملی منطق اور تخلیقی ادراک کے درمیان فکری توازن ظاہر کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೌಮ್ಯ ಇಳಿಜಾರು ಪ್ರಾಯೋಗಿಕ ತರ್ಕ ಮತ್ತು ಸೃಜನಶೀಲ ಗ್ರಹಿಕೆಯ ನಡುವಿನ ಬೌದ್ಧಿಕ ಸಮತೋಲನವನ್ನು ಬಹಿರಂಗಪಡಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ହାଲୁକା ଢାଲ ବ୍ୟାବହାରିକ ତର୍କ ଓ ସୃଜନଶୀଳ ଧାରଣା ମଧ୍ୟରେ ବୌଦ୍ଧିକ ସନ୍ତୁଳନ ପ୍ରକାଶ କରେ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൃദുവായ ചരിവ് പ്രായോഗിക യുക്തിക്കും സർഗാത്മക ഗ്രഹണത്തിനും ഇടയിലുള്ള ബൗദ്ധിക സന്തുലനം വെളിപ്പെടുത്തുന്നു."
          }
        }
      }
    },
    "head.adaptive.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive & Multidisciplinary Mind"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुकूलनशील और बहुविषयी मन"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অভিযোজনশীল ও বহুমুখী মন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जुळवून घेणारे आणि बहुविषयक मन"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనుకూలమైన మరియు బహుముఖ మనస్సు"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தகவமைக்கும் மற்றும் பல்துறை மனம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનુકૂલનશીલ અને બહુવિષયક મન"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لچکدار اور ہمہ جہت ذہن"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಂದಿಕೊಳ್ಳುವ ಮತ್ತು ಬಹುಶಿಸ್ತೀಯ ಮನಸ್ಸು"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଖାପ ଖୁଆଉଥିବା ଓ ବହୁମୁଖୀ ମନ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൊരുത്തപ്പെടുന്നതും ബഹുമുഖവുമായ മനസ്സ്"
          }
        }
      }
    },
