    "mount.apollo.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well-developed Apollo mount brings an appreciation for aesthetic beauty, charisma, warmth, and creative self-expression."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विकसित सूर्य पर्वत सौंदर्य की सराहना, आकर्षण, आत्मीयता और रचनात्मक आत्म-अभिव्यक्ति लाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুবিকশিত রবি পর্বত সৌন্দর্যবোধ, আকর্ষণ, উষ্ণতা ও সৃজনশীল আত্মপ্রকাশ এনে দেয়।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विकसित रवी पर्वत सौंदर्याची जाण, आकर्षकता, आपुलकी आणि सर्जनशील आत्माभिव्यक्ती देतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బాగా అభివృద్ధి చెందిన సూర్య పర్వతం సౌందర్యాభిరుచి, ఆకర్షణ, ఆప్యాయత మరియు సృజనాత్మక స్వీయ వ్యక్తీకరణను అందిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நன்கு வளர்ந்த சூரிய மேடு அழகுணர்ச்சி, வசீகரம், அன்பு மற்றும் படைப்புத்திறன் மிக்க சுய வெளிப்பாட்டை அளிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિકસિત સૂર્ય પર્વત સૌંદર્યની કદર, આકર્ષણ, હૂંફ અને સર્જનાત્મક આત્મ-અભિવ્યક્તિ લાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اچھی طرح ابھرا ہوا شمس کا ابھار حسن کی قدر، کشش، گرم جوشی اور تخلیقی اظہارِ ذات عطا کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚೆನ್ನಾಗಿ ಬೆಳೆದ ಸೂರ್ಯ ಪರ್ವತವು ಸೌಂದರ್ಯಪ್ರಜ್ಞೆ, ಆಕರ್ಷಣೆ, ಆತ್ಮೀಯತೆ ಮತ್ತು ಸೃಜನಶೀಲ ಸ್ವ-ಅಭಿವ್ಯಕ್ತಿಯನ್ನು ನೀಡುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିକଶିତ ସୂର୍ଯ୍ୟ ପର୍ବତ ସୌନ୍ଦର୍ଯ୍ୟବୋଧ, ଆକର୍ଷଣ, ଆନ୍ତରିକତା ଓ ସୃଜନଶୀଳ ଆତ୍ମପ୍ରକାଶ ଆଣେ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നന്നായി വികസിച്ച സൂര്യ പർവ്വതം സൗന്ദര്യബോധം, ആകർഷണീയത, ഊഷ്മളത, സർഗാത്മക ആത്മപ്രകാശനം എന്നിവ നൽകുന്നു."
          }
        }
      }
    },
