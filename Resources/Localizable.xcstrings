        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रमुख, विस्तृत चाप मज़बूत पुनर्प्राप्ति क्षमता, व्यक्तित्व की आत्मीयता और जीवन के रोमांच के प्रति खुले दृष्टिकोण को दर्शाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি স্পষ্ট, বিস্তৃত বাঁক দৃঢ় পুনরুদ্ধার ক্ষমতা, ব্যক্তিত্বের উষ্ণতা এবং জীবনের অভিযানের প্রতি খোলা মনোভাব নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ठळक, विस्तृत कमान भक्कम पुनर्प्राप्ती क्षमता, व्यक्तिमत्त्वातील आपुलकी आणि जीवनातील साहसांकडे मोकळा दृष्टिकोन दर्शवते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రముఖమైన, విశాలమైన వంపు బలమైన కోలుకునే సత్తువ, వ్యక్తిత్వంలో ఆప్యాయత మరియు జీవిత సాహసాల పట్ల విశాల దృక్పథాన్ని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தெளிவான, விரிந்த வளைவு வலுவான மீட்சித் திறன், ஆளுமையின் அரவணைப்பு மற்றும் வாழ்க்கைச் சாகசங்களுக்குத் திறந்த அணுகுமுறையைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક મુખ્ય, વિશાળ ચાપ મજબૂત પુનઃપ્રાપ્તિ ક્ષમતા, વ્યક્તિત્વની હૂંફ અને જીવનના સાહસો પ્રત્યે ખુલ્લો અભિગમ દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایاں، وسیع قوس مضبوط بحالی کی صلاحیت، شخصیت کی گرم جوشی اور زندگی کی مہمات کے لیے کھلے رویے کی علامت ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎದ್ದುಕಾಣುವ, ವಿಶಾಲ ಕಮಾನು ಬಲವಾದ ಚೇತರಿಕೆಯ ತ್ರಾಣ, ವ್ಯಕ್ತಿತ್ವದ ಆತ್ಮೀಯತೆ ಮತ್ತು ಜೀವನದ ಸಾಹಸಗಳ ಕಡೆಗೆ ಮುಕ್ತ ದೃಷ್ಟಿಕೋನವನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ସ୍ପଷ୍ଟ, ବିସ୍ତୃତ ବାଙ୍କ ଦୃଢ଼ ପୁନରୁଦ୍ଧାର କ୍ଷମତା, ବ୍ୟକ୍ତିତ୍ୱର ଆନ୍ତରିକତା ଓ ଜୀବନର ଦୁଃସାହସିକ ଅଭିଯାନ ପ୍ରତି ଖୋଲା ମନୋଭାବ ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യക്തവും വിശാലവുമായ വളവ് ശക്തമായ വീണ്ടെടുക്കൽ ശേഷി, വ്യക്തിത്വത്തിലെ ഊഷ്മളത, ജീവിതസാഹസങ്ങളോടുള്ള തുറന്ന സമീപനം എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
    "life.expansive.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expansive Vitality & Dynamic Stamina"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विस्तृत जीवनशक्ति और गतिशील ऊर्जा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিস্তৃত প্রাণশক্তি ও গতিশীল উদ্যম"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विस्तृत चैतन्य आणि गतिशील ऊर्जा"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విశాలమైన జీవశక్తి మరియు చైతన్యవంతమైన సత్తువ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரிந்த உயிர்ச்சக்தி மற்றும் துடிப்பான ஆற்றல்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિસ્તૃત જીવનશક્તિ અને ગતિશીલ ઊર્જા"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وسیع توانائی اور متحرک قوت"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಸ್ತಾರವಾದ ಜೀವಶಕ್ತಿ ಮತ್ತು ಚೈತನ್ಯಶೀಲ ತ್ರಾಣ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିସ୍ତୃତ ଜୀବନୀଶକ୍ତି ଓ ଗତିଶୀଳ ଉଦ୍ୟମ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിശാലമായ ജീവശക്തിയും ചലനാത്മക ഊർജ്ജവും"
          }
        }
      }
    },
