    "mount.moon.keyword": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intuition & Imagination"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतर्ज्ञान और कल्पना"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্তর্দৃষ্টি ও কল্পনা"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतःप्रेरणा आणि कल्पनाशक्ती"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతర్బుద్ధి మరియు ఊహాశక్తి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளுணர்வு மற்றும் கற்பனை"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અંતઃસ્ફુરણા અને કલ્પના"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وجدان اور تخیل"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂತಃಪ್ರಜ್ಞೆ ಮತ್ತು ಕಲ್ಪನೆ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନ୍ତର୍ଜ୍ଞାନ ଓ କଳ୍ପନା"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അന്തർജ്ഞാനവും ഭാവനയും"
          }
        }
      }
    },
    "mount.moon.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expansive Mount of Moon (Luna) denotes receptive intuition, vivid imagination, dream awareness, and spiritual attunement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विस्तृत चंद्र पर्वत ग्रहणशील अंतर्ज्ञान, जीवंत कल्पना, स्वप्न-जागरूकता और आध्यात्मिक जुड़ाव का सूचक है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিস্তৃত চন্দ্র পর্বত গ্রহণশীল অন্তর্দৃষ্টি, প্রাণবন্ত কল্পনা, স্বপ্ন-সচেতনতা ও আধ্যাত্মিক সংযোগ নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विस्तृत चंद्र पर्वत ग्रहणशील अंतःप्रेरणा, जिवंत कल्पनाशक्ती, स्वप्नजाणीव आणि आध्यात्मिक जवळीक दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విశాలమైన చంద్ర పర్వతం గ్రహణశీల అంతర్బుద్ధి, స్పష్టమైన ఊహాశక్తి, కలల అవగాహన మరియు ఆధ్యాత్మిక అనుబంధాన్ని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரிந்த சந்திர மேடு ஏற்கும் உள்ளுணர்வு, தெளிவான கற்பனை, கனவு விழிப்புணர்வு மற்றும் ஆன்மீக இணைப்பைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિસ્તૃત ચંદ્ર પર્વત ગ્રહણશીલ અંતઃસ્ફુરણા, જીવંત કલ્પના, સ્વપ્ન-જાગૃતિ અને આધ્યાત્મિક જોડાણ સૂચવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وسیع قمر کا ابھار قبول کرنے والا وجدان، روشن تخیل، خوابوں کا شعور اور روحانی ربط ظاہر کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಶಾಲ ಚಂದ್ರ ಪರ್ವತವು ಗ್ರಹಣಶೀಲ ಅಂತಃಪ್ರಜ್ಞೆ, ಸ್ಪಷ್ಟ ಕಲ್ಪನೆ, ಕನಸಿನ ಅರಿವು ಮತ್ತು ಆಧ್ಯಾತ್ಮಿಕ ಸಂಪರ್ಕವನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିସ୍ତୃତ ଚନ୍ଦ୍ର ପର୍ବତ ଗ୍ରହଣଶୀଳ ଅନ୍ତର୍ଜ୍ଞାନ, ଜୀବନ୍ତ କଳ୍ପନା, ସ୍ୱପ୍ନ-ସଚେତନତା ଓ ଆଧ୍ୟାତ୍ମିକ ସଂଯୋଗ ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിശാലമായ ചന്ദ്ര പർവ്വതം സ്വീകാര്യമായ അന്തർജ്ഞാനം, ഉജ്ജ്വലമായ ഭാവന, സ്വപ്നബോധം, ആത്മീയ ബന്ധം എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
