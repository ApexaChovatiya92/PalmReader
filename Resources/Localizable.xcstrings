          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லட்சியம் மற்றும் தலைமை"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મહત્વાકાંક્ષા અને નેતૃત્વ"
          }
        },
        "ur": {
          "stringUnit": {
