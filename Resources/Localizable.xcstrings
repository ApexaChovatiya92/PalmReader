    "element.water": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water Hand"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जल हस्त"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জল হস্ত"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जल हस्त"
          }
        },
        "te": {
          "stringUnit": {
