    "home.dailyInsight.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to reflect on today's elemental energy"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की तात्विक ऊर्जा पर चिंतन के लिए टैप करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের মৌলিক শক্তি নিয়ে ভাবতে ট্যাপ করুন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजच्या तत्त्व ऊर्जेवर चिंतन करण्यासाठी टॅप करा"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేటి మూలక శక్తిపై ఆలోచించడానికి ట్యాప్ చేయండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய பூத சக்தியைச் சிந்திக்கத் தட்டவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજની તત્ત્વ ઊર્જા પર ચિંતન કરવા ટૅપ કરો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی عنصری توانائی پر غور کرنے کے لیے ٹیپ کریں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದಿನ ತತ್ವ ಶಕ್ತಿಯ ಬಗ್ಗೆ ಚಿಂತಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜିର ତତ୍ତ୍ୱ ଶକ୍ତି ଉପରେ ଚିନ୍ତନ ପାଇଁ ଟ୍ୟାପ କରନ୍ତୁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ തത്ത്വ ഊർജ്ജത്തെക്കുറിച്ച് ചിന്തിക്കാൻ ടാപ്പ് ചെയ്യുക"
          }
        }
      }
    },
    "home.dailyInsight.title": {
