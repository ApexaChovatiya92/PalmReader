    "history.notes.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MY PERSONAL REFLECTION NOTES"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे व्यक्तिगत चिंतन नोट्स"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার ব্যক্তিগত ভাবনার নোট"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "माझ्या वैयक्तिक चिंतन नोंदी"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నా వ్యక్తిగత ఆలోచనల గమనికలు"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எனது தனிப்பட்ட சிந்தனைக் குறிப்புகள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મારી વ્યક્તિગત ચિંતન નોંધો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میرے ذاتی غور و فکر کے نوٹس"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನನ್ನ ವೈಯಕ್ತಿಕ ಚಿಂತನಾ ಟಿಪ್ಪಣಿಗಳು"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୋର ବ୍ୟକ୍ତିଗତ ଚିନ୍ତନ ଟିପ୍ପଣୀ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്റെ വ്യക്തിഗത ചിന്താ കുറിപ്പുകൾ"
          }
        }
      }
    },
    "history.notes.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add thoughts, life events, or feelings from this reading..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रीडिंग से जुड़े विचार, जीवन की घटनाएँ या भावनाएँ लिखें..."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পাঠ নিয়ে ভাবনা, জীবনের ঘটনা বা অনুভূতি লিখুন..."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या वाचनाशी संबंधित विचार, जीवनातील घटना किंवा भावना लिहा..."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పఠనానికి సంబంధించిన ఆలోచనలు, జీవిత సంఘటనలు లేదా భావాలను రాయండి..."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வாசிப்பு தொடர்பான எண்ணங்கள், வாழ்க்கை நிகழ்வுகள் அல்லது உணர்வுகளை எழுதுங்கள்..."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વાંચન સંબંધિત વિચારો, જીવનના પ્રસંગો અથવા લાગણીઓ લખો..."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریڈنگ سے متعلق خیالات، زندگی کے واقعات یا احساسات لکھیں..."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಓದಿಗೆ ಸಂಬಂಧಿಸಿದ ಆಲೋಚನೆಗಳು, ಜೀವನದ ಘಟನೆಗಳು ಅಥವಾ ಭಾವನೆಗಳನ್ನು ಬರೆಯಿರಿ..."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ପଠନ ସମ୍ବନ୍ଧୀୟ ଚିନ୍ତା, ଜୀବନର ଘଟଣା ବା ଅନୁଭୂତି ଲେଖନ୍ତୁ..."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വായനയുമായി ബന്ധപ്പെട്ട ചിന്തകൾ, ജീവിത സംഭവങ്ങൾ അല്ലെങ്കിൽ വികാരങ്ങൾ എഴുതുക..."
          }
        }
      }
    },
    "history.savedAnalysis": {
