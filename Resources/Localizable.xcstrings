        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂಗೈ ಪರ್ವತಗಳು ಮತ್ತು ಗ್ರಹ ಸ್ವರೂಪಗಳು"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାପୁଲିର ପର୍ବତ ଓ ଗ୍ରହ ସ୍ୱରୂପ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൈപ്പത്തിയിലെ പർവ്വതങ്ങളും ഗ്രഹരൂപങ്ങളും"
          }
        }
      }
    },
