    "home.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align your hand in the camera to begin your first palm analysis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पहला हस्तरेखा विश्लेषण शुरू करने के लिए अपना हाथ कैमरे के सामने रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রথম হস্তরেখা বিশ্লেষণ শুরু করতে হাতটি ক্যামেরার সামনে রাখুন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे पहिले हस्तरेषा विश्लेषण सुरू करण्यासाठी तुमचा हात कॅमेऱ्यासमोर धरा."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మొదటి హస్తరేఖ విశ్లేషణను ప్రారంభించడానికి మీ చేయిని కెమెరా ముందు ఉంచండి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முதல் கைரேகை பகுப்பாய்வைத் தொடங்க உங்கள் கையை கேமராவின் முன் வைக்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું પ્રથમ હસ્તરેખા વિશ્લેષણ શરૂ કરવા માટે તમારો હાથ કૅમેરા સામે રાખો."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا پہلا ہتھیلی تجزیہ شروع کرنے کے لیے اپنا ہاتھ کیمرے کے سامنے رکھیں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೊದಲ ಹಸ್ತರೇಖಾ ವಿಶ್ಲೇಷಣೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ನಿಮ್ಮ ಕೈಯನ್ನು ಕ್ಯಾಮೆರಾದ ಮುಂದೆ ಇರಿಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ରଥମ ହସ୍ତରେଖା ବିଶ୍ଳେଷଣ ଆରମ୍ଭ କରିବା ପାଇଁ ହାତକୁ କ୍ୟାମେରା ସାମ୍ନାରେ ରଖନ୍ତୁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ആദ്യ ഹസ്തരേഖാ വിശകലനം ആരംഭിക്കാൻ കൈ ക്യാമറയ്ക്ക് മുന്നിൽ വയ്ക്കുക."
          }
        }
      }
    },
    "home.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
