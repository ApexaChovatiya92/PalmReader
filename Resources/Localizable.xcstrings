          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଛୋଟ ବୁଢ଼ା ଆଙ୍ଗୁଠି"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
