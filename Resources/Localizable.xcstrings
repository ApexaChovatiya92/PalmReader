        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరిగ్గా ఉంది! చదవడానికి సిద్ధం..."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மிகச் சரி! வாசிக்கத் தயார்..."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એકદમ યોગ્ય! વાંચવા માટે તૈયાર..."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بالکل درست! پڑھنے کے لیے تیار..."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರಿಯಾಗಿದೆ! ಓದಲು ಸಿದ್ಧ..."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକଦମ ଠିକ୍! ପଢ଼ିବାକୁ ପ୍ରସ୍ତୁତ..."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൃത്യം! വായിക്കാൻ തയ്യാർ..."
          }
        }
      }
    },
    "guidance.placeHand.left": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your left hand inside the guide frame"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना बायाँ हाथ गाइड फ्रेम के अंदर रखें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বাঁ হাত গাইড ফ্রেমের ভেতরে রাখুন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा डावा हात मार्गदर्शक फ्रेमच्या आत ठेवा"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఎడమ చేయిని గైడ్ ఫ్రేమ్ లోపల ఉంచండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இடது கையை வழிகாட்டி சட்டகத்துக்குள் வைக்கவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ડાબો હાથ ગાઇડ ફ્રેમની અંદર રાખો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا بایاں ہاتھ گائیڈ فریم کے اندر رکھیں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಎಡಗೈಯನ್ನು ಮಾರ್ಗದರ್ಶಿ ಚೌಕಟ್ಟಿನೊಳಗೆ ಇರಿಸಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବାମ ହାତକୁ ଗାଇଡ ଫ୍ରେମ ଭିତରେ ରଖନ୍ତୁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഇടതു കൈ ഗൈഡ് ഫ്രെയിമിനുള്ളിൽ വയ്ക്കുക"
          }
        }
      }
    },
    "guidance.placeHand.right": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your right hand inside the guide frame"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना दायाँ हाथ गाइड फ्रेम के अंदर रखें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডান হাত গাইড ফ্রেমের ভেতরে রাখুন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा उजवा हात मार्गदर्शक फ्रेमच्या आत ठेवा"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కుడి చేయిని గైడ్ ఫ్రేమ్ లోపల ఉంచండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வலது கையை வழிகாட்டி சட்டகத்துக்குள் வைக்கவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો જમણો હાથ ગાઇડ ફ્રેમની અંદર રાખો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا دایاں ہاتھ گائیڈ فریم کے اندر رکھیں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬಲಗೈಯನ್ನು ಮಾರ್ಗದರ್ಶಿ ಚೌಕಟ್ಟಿನೊಳಗೆ ಇರಿಸಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଡାହାଣ ହାତକୁ ଗାଇଡ ଫ୍ରେମ ଭିତରେ ରଖନ୍ତୁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വലതു കൈ ഗൈഡ് ഫ്രെയിമിനുള്ളിൽ വയ്ക്കുക"
          }
        }
      }
    },
