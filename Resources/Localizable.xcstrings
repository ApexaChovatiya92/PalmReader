    "quiz.q1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which line curves around the base of the thumb?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन-सी रेखा अंगूठे के आधार के चारों ओर घूमती है?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন রেখা বুড়ো আঙুলের গোড়ার চারপাশে বেঁকে যায়?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणती रेषा अंगठ्याच्या मुळाभोवती वळते?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ రేఖ బొటనవేలి మూలం చుట్టూ వంగుతుంది?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த ரேகை கட்டைவிரலின் அடிப்பகுதியைச் சுற்றி வளைகிறது?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કઈ રેખા અંગૂઠાના મૂળની આસપાસ વળે છે?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کون سی لکیر انگوٹھے کی جڑ کے گرد گھومتی ہے؟"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವ ರೇಖೆ ಹೆಬ್ಬೆರಳಿನ ಬುಡದ ಸುತ್ತ ಬಾಗುತ್ತದೆ?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେଉଁ ରେଖା ବୁଢ଼ା ଆଙ୍ଗୁଠିର ମୂଳ ଚାରିପଟେ ବୁଲିଯାଏ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തള്ളവിരലിന്റെ ചുവടിനു ചുറ്റും വളയുന്ന രേഖ ഏത്?"
          }
        }
      }
    },
    "quiz.q2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
