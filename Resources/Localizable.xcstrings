    "quiz.q5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which mount forms the fleshy base of the thumb?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन-सा पर्वत अंगूठे का मांसल आधार बनाता है?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন পর্বত বুড়ো আঙুলের মাংসল গোড়া গঠন করে?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणता पर्वत अंगठ्याचा मांसल पाया बनवतो?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ పర్వతం బొటనవేలి కండగల మూలాన్ని ఏర్పరుస్తుంది?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த மேடு கட்டைவிரலின் சதைப்பற்றான அடிப்பகுதியை உருவாக்குகிறது?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કયો પર્વત અંગૂઠાનો માંસલ આધાર બનાવે છે?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کون سا ابھار انگوٹھے کی گوشت دار جڑ بناتا ہے؟"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವ ಪರ್ವತ ಹೆಬ್ಬೆರಳಿನ ಮಾಂಸಲ ಬುಡವನ್ನು ರೂಪಿಸುತ್ತದೆ?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେଉଁ ପର୍ବତ ବୁଢ଼ା ଆଙ୍ଗୁଠିର ମାଂସଳ ମୂଳ ଗଠନ କରେ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തള്ളവിരലിന്റെ മാംസളമായ ചുവട് രൂപപ്പെടുത്തുന്ന പർവ്വതം ഏത്?"
          }
        }
      }
    },
