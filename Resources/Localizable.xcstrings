    "handShape.indexRing.index.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Jupiter finger leads: traditionally a sign of self-confidence and a natural pull toward leadership."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरु की उंगली आगे है: परंपरागत रूप से आत्मविश्वास और नेतृत्व की ओर स्वाभाविक झुकाव का संकेत।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বৃহস্পতির আঙুল এগিয়ে: ঐতিহ্যগতভাবে আত্মবিশ্বাস ও নেতৃত্বের প্রতি স্বাভাবিক টানের চিহ্ন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरूचे बोट पुढे आहे: परंपरेनुसार आत्मविश्वास आणि नेतृत्वाकडे नैसर्गिक ओढ यांचे चिन्ह."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గురు వేలు ముందుంది: సంప్రదాయంగా ఆత్మవిశ్వాసం మరియు నాయకత్వం వైపు సహజ ఆకర్షణకు సంకేతం."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரு விரல் முன்னிலையில்: மரபுப்படி தன்னம்பிக்கை மற்றும் தலைமைக்கான இயல்பான ஈர்ப்பின் அடையாளம்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગુરુની આંગળી આગળ છે: પરંપરાગત રીતે આત્મવિશ્વાસ અને નેતૃત્વ તરફના સ્વાભાવિક ઝુકાવનો સંકેત."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشتری کی انگلی آگے ہے: روایتی طور پر خود اعتمادی اور قیادت کی طرف فطری رجحان کی علامت۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುರು ಬೆರಳು ಮುಂದಿದೆ: ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಆತ್ಮವಿಶ್ವಾಸ ಮತ್ತು ನಾಯಕತ್ವದತ್ತ ಸಹಜ ಒಲವಿನ ಸಂಕೇತ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୁରୁଙ୍କ ଆଙ୍ଗୁଠି ଆଗରେ: ପରମ୍ପରା ଅନୁସାରେ ଆତ୍ମବିଶ୍ୱାସ ଓ ନେତୃତ୍ୱ ପ୍ରତି ସ୍ୱାଭାବିକ ଆକର୍ଷଣର ସଙ୍କେତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗുരുവിന്റെ വിരൽ മുന്നിൽ: പരമ്പരാഗതമായി ആത്മവിശ്വാസത്തിന്റെയും നേതൃത്വത്തോടുള്ള സ്വാഭാവിക ആകർഷണത്തിന്റെയും ചിഹ്നം."
          }
        }
      }
    },
    "handShape.indexRing.ring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring finger longer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनामिका लंबी"
          }
        },
        "bn": {
          "stringUnit": {
