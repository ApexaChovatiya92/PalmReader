          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनामिका लांब"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉంగరపు వేలు పొడవు"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மோதிர விரல் நீளம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનામિકા લાંબી"
          }
        },
        "ur": {
          "stringUnit": {
