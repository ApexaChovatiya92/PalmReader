    "learn.topic.photo.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a Good Palm Photo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हथेली की अच्छी फ़ोटो कैसे लें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তালুর ভালো ছবি তোলার উপায়"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
