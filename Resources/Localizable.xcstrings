    "marking.cross.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mystic Cross denotes strong intuitive gut feelings, spiritual curiosity, and uncanny sixth sense."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रहस्यमय क्रॉस प्रबल अंतर्ज्ञान, आध्यात्मिक जिज्ञासा और अद्भुत छठी इंद्रिय का संकेत है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রহস্যময় ক্রস প্রবল অন্তর্দৃষ্টি, আধ্যাত্মিক কৌতূহল এবং বিস্ময়কর ষষ্ঠ ইন্দ্রিয় নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गूढ क्रॉस प्रबळ अंतःप्रेरणा, आध्यात्मिक जिज्ञासा आणि विलक्षण सहावे इंद्रिय दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రహస్య క్రాస్ బలమైన అంతర్బుద్ధి, ఆధ్యాత్మిక జిజ్ఞాస మరియు అద్భుతమైన ఆరవ ఇంద్రియాన్ని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மர்மக் குறுக்குக்குறி வலுவான உள்ளுணர்வு, ஆன்மீக ஆர்வம் மற்றும் வியக்கத்தக்க ஆறாம் அறிவைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રહસ્યમય ક્રૉસ પ્રબળ અંતઃસ્ફુરણા, આધ્યાત્મિક જિજ્ઞાસા અને અદ્ભુત છઠ્ઠી ઇન્દ્રિય દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پراسرار صلیب مضبوط وجدان، روحانی تجسس اور حیرت انگیز چھٹی حس کی علامت ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಹಸ್ಯ ಅಡ್ಡಗೆರೆಯು ಬಲವಾದ ಅಂತಃಪ್ರಜ್ಞೆ, ಆಧ್ಯಾತ್ಮಿಕ ಕುತೂಹಲ ಮತ್ತು ಅದ್ಭುತ ಆರನೇ ಇಂದ್ರಿಯವನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରହସ୍ୟମୟ କ୍ରସ ପ୍ରବଳ ଅନ୍ତର୍ଜ୍ଞାନ, ଆଧ୍ୟାତ୍ମିକ ଜିଜ୍ଞାସା ଓ ଅଦ୍ଭୁତ ଷଷ୍ଠ ଇନ୍ଦ୍ରିୟ ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിഗൂഢ കുരിശ് ശക്തമായ അന്തർജ്ഞാനം, ആത്മീയ ജിജ്ഞാസ, അസാധാരണമായ ആറാം ഇന്ദ്രിയം എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
