    "hand.right.tradition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active / Conscious Potential: Reflects choices, current direction, and manifest life."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय / सचेत क्षमता: आपके चुनाव, वर्तमान दिशा और साकार जीवन को दर्शाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সক্রিয় / সচেতন সম্ভাবনা: আপনার সিদ্ধান্ত, বর্তমান দিশা ও বাস্তব জীবনকে প্রতিফলিত করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय / जाणीवपूर्वक क्षमता: तुमच्या निवडी, सध्याची दिशा आणि साकार जीवन दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్రియాశీల / చేతన సామర్థ్యం: మీ ఎంపికలు, ప్రస్తుత దిశ మరియు వ్యక్తమైన జీవితాన్ని ప్రతిబింబిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்படும் / விழிப்புணர்வுத் திறன்: உங்கள் தேர்வுகள், தற்போதைய திசை மற்றும் வெளிப்படும் வாழ்க்கையைப் பிரதிபலிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સક્રિય / સભાન ક્ષમતા: તમારી પસંદગીઓ, વર્તમાન દિશા અને સાકાર જીવન દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال / شعوری صلاحیت: آپ کے انتخاب، موجودہ سمت اور ظاہر زندگی کی عکاسی کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಕ್ರಿಯ / ಪ್ರಜ್ಞಾಪೂರ್ವಕ ಸಾಮರ್ಥ್ಯ: ನಿಮ್ಮ ಆಯ್ಕೆಗಳು, ಪ್ರಸ್ತುತ ದಿಕ್ಕು ಮತ್ತು ವ್ಯಕ್ತವಾದ ಜೀವನವನ್ನು ಪ್ರತಿಬಿಂಬಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସକ୍ରିୟ / ସଚେତନ ସମ୍ଭାବନା: ଆପଣଙ୍କ ପସନ୍ଦ, ବର୍ତ୍ତମାନର ଦିଗ ଓ ପ୍ରକଟ ଜୀବନକୁ ଦର୍ଶାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സജീവ / ബോധപൂർവമായ സാധ്യത: നിങ്ങളുടെ തിരഞ്ഞെടുപ്പുകൾ, നിലവിലെ ദിശ, പ്രകടമായ ജീവിതം എന്നിവ പ്രതിഫലിപ്പിക്കുന്നു."
          }
        }
      }
    },
