    },
    "mount.jupiter.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevated Jupiter indicates natural presence, honorable leadership, and a genuine ambition to uplift others."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उभरा हुआ गुरु पर्वत स्वाभाविक प्रभाव, सम्मानजनक नेतृत्व और दूसरों को ऊपर उठाने की सच्ची महत्वाकांक्षा दर्शाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উঁচু বৃহস্পতি পর্বত স্বাভাবিক ব্যক্তিত্ব, সম্মানজনক নেতৃত্ব এবং অন্যকে এগিয়ে নেওয়ার আন্তরিক উচ্চাকাঙ্ক্ষা নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उंच गुरु पर्वत नैसर्गिक प्रभाव, सन्माननीय नेतृत्व आणि इतरांना उन्नत करण्याची खरी महत्त्वाकांक्षा दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉన్నతమైన గురు పర్వతం సహజమైన ప్రభావం, గౌరవప్రదమైన నాయకత్వం మరియు ఇతరులను ఉన్నతికి తీసుకెళ్లాలనే నిజమైన ఆకాంక్షను సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உயர்ந்த குரு மேடு இயல்பான ஆளுமை, மரியாதைக்குரிய தலைமை மற்றும் பிறரை உயர்த்தும் உண்மையான லட்சியத்தைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઊપસેલો ગુરુ પર્વત સ્વાભાવિક પ્રભાવ, સન્માનજનક નેતૃત્વ અને બીજાને આગળ વધારવાની સાચી મહત્વાકાંક્ષા દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلند مشتری کا ابھار فطری وقار، باعزت قیادت اور دوسروں کو آگے بڑھانے کی سچی خواہش ظاہر کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎತ್ತರದ ಗುರು ಪರ್ವತವು ಸಹಜ ವ್ಯಕ್ತಿತ್ವ, ಗೌರವಾನ್ವಿತ ನಾಯಕತ್ವ ಮತ್ತು ಇತರರನ್ನು ಮೇಲೆತ್ತುವ ನಿಜವಾದ ಮಹತ್ವಾಕಾಂಕ್ಷೆಯನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉଚ୍ଚ ଗୁରୁ ପର୍ବତ ସ୍ୱାଭାବିକ ବ୍ୟକ୍ତିତ୍ୱ, ସମ୍ମାନଜନକ ନେତୃତ୍ୱ ଓ ଅନ୍ୟମାନଙ୍କୁ ଆଗକୁ ନେବାର ପ୍ରକୃତ ଉଚ୍ଚାକାଂକ୍ଷା ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉയർന്ന ഗുരു പർവ്വതം സ്വാഭാവിക വ്യക്തിപ്രഭാവം, മാന്യമായ നേതൃത്വം, മറ്റുള്ളവരെ ഉയർത്താനുള്ള യഥാർത്ഥ അഭിലാഷം എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
