    },
    "element.air.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A square palm with longer fingers. Traditionally curious, analytical and articulate, driven by ideas and conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्गाकार हथेली और लंबी उंगलियाँ। परंपरागत रूप से जिज्ञासु, विश्लेषणात्मक और मुखर, विचारों और बातचीत से प्रेरित।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্গাকার তালু ও লম্বা আঙুল। ঐতিহ্যগতভাবে কৌতূহলী, বিশ্লেষণী ও বাকপটু, ভাবনা ও আলাপে অনুপ্রাণিত।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चौकोनी तळहात आणि लांब बोटे. परंपरेनुसार जिज्ञासू, विश्लेषक आणि बोलके, कल्पना आणि संवादाने प्रेरित."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చతురస్రాకార అరచేతి, పొడవైన వేళ్లు. సంప్రదాయంగా జిజ్ఞాసులు, విశ్లేషకులు, మాటకారులు, ఆలోచనలు మరియు సంభాషణలతో ప్రేరణ పొందేవారు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சதுர உள்ளங்கை, நீண்ட விரல்கள். மரபுப்படி ஆர்வமுள்ளவர்கள், பகுப்பாய்வாளர்கள், சொல்வன்மை மிக்கவர்கள், கருத்துகளாலும் உரையாடலாலும் உந்தப்படுபவர்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચોરસ હથેળી અને લાંબી આંગળીઓ. પરંપરાગત રીતે જિજ્ઞાસુ, વિશ્લેષણાત્મક અને વાક્પટુ, વિચારો અને વાતચીતથી પ્રેરિત."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چوکور ہتھیلی اور لمبی انگلیاں۔ روایتی طور پر متجسس، تجزیاتی اور خوش گفتار، خیالات اور گفتگو سے متاثر۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚೌಕ ಅಂಗೈ ಮತ್ತು ಉದ್ದ ಬೆರಳುಗಳು. ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಕುತೂಹಲಿ, ವಿಶ್ಲೇಷಣಾತ್ಮಕ ಮತ್ತು ಮಾತುಗಾರರು, ಆಲೋಚನೆಗಳು ಮತ್ತು ಸಂಭಾಷಣೆಯಿಂದ ಪ್ರೇರಿತರು."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବର୍ଗାକାର ପାପୁଲି ଓ ଲମ୍ବା ଆଙ୍ଗୁଠି। ପରମ୍ପରା ଅନୁସାରେ ଜିଜ୍ଞାସୁ, ବିଶ୍ଳେଷଣଶୀଳ ଓ ବାକ୍‌ପଟୁ, ଚିନ୍ତା ଓ ଆଲୋଚନାରୁ ପ୍ରେରିତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചതുര കൈപ്പത്തിയും നീണ്ട വിരലുകളും. പരമ്പരാഗതമായി ജിജ്ഞാസുക്കൾ, വിശകലനശീലർ, വാക്ചാതുര്യമുള്ളവർ, ആശയങ്ങളും സംഭാഷണവും പ്രചോദനമാകുന്നവർ."
          }
        }
      }
    },
