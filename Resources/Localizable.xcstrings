        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉદાત્ત અને આદર્શવાદી હૃદય"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شریف اور مثالی دل"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉದಾತ್ತ ಮತ್ತು ಆದರ್ಶವಾದಿ ಹೃದಯ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମହାନ ଓ ଆଦର୍ଶବାଦୀ ହୃଦୟ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉദാത്തവും ആദർശപരവുമായ ഹൃദയം"
          }
        }
      }
    },
