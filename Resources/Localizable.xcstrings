    "element.water.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long palm with longer fingers. Traditionally sensitive, intuitive and imaginative, deeply attuned to feelings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबी हथेली और लंबी उंगलियाँ। परंपरागत रूप से संवेदनशील, अंतर्ज्ञानी और कल्पनाशील, भावनाओं से गहराई से जुड़े।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লম্বা তালু ও লম্বা আঙুল। ঐতিহ্যগতভাবে সংবেদনশীল, অন্তর্দৃষ্টিসম্পন্ন ও কল্পনাপ্রবণ, অনুভূতির সঙ্গে গভীরভাবে যুক্ত।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लांब तळहात आणि लांब बोटे. परंपरेनुसार संवेदनशील, अंतर्ज्ञानी आणि कल्पक, भावनांशी खोलवर जोडलेले."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పొడవైన అరచేతి, పొడవైన వేళ్లు. సంప్రదాయంగా సున్నితమైనవారు, అంతర్బుద్ధిగలవారు, ఊహాశీలురు, భావాలతో లోతుగా అనుసంధానమైనవారు."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீண்ட உள்ளங்கை, நீண்ட விரல்கள். மரபுப்படி நுண்ணுணர்வு, உள்ளுணர்வு, கற்பனை மிக்கவர்கள், உணர்வுகளுடன் ஆழமாக இணைந்தவர்கள்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાંબી હથેળી અને લાંબી આંગળીઓ. પરંપરાગત રીતે સંવેદનશીલ, અંતઃસ્ફુરિત અને કલ્પનાશીલ, લાગણીઓ સાથે ઊંડાણથી જોડાયેલા."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لمبی ہتھیلی اور لمبی انگلیاں۔ روایتی طور پر حساس، وجدانی اور تخیلاتی، جذبات سے گہرائی سے جڑے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉದ್ದ ಅಂಗೈ ಮತ್ತು ಉದ್ದ ಬೆರಳುಗಳು. ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಸೂಕ್ಷ್ಮ, ಅಂತಃಪ್ರಜ್ಞೆಯ ಮತ್ತು ಕಲ್ಪನಾಶೀಲರು, ಭಾವನೆಗಳೊಂದಿಗೆ ಆಳವಾಗಿ ಬೆಸೆದವರು."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲମ୍ବା ପାପୁଲି ଓ ଲମ୍ବା ଆଙ୍ଗୁଠି। ପରମ୍ପରା ଅନୁସାରେ ସମ୍ବେଦନଶୀଳ, ଅନ୍ତର୍ଜ୍ଞାନୀ ଓ କଳ୍ପନାଶୀଳ, ଭାବନା ସହ ଗଭୀର ଭାବେ ଯୋଡ଼ା।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീണ്ട കൈപ്പത്തിയും നീണ്ട വിരലുകളും. പരമ്പരാഗതമായി സംവേദനശീലർ, അന്തർജ്ഞാനമുള്ളവർ, ഭാവനാസമ്പന്നർ, വികാരങ്ങളുമായി ആഴത്തിൽ ബന്ധമുള്ളവർ."
          }
        }
      }
    },
    "element.water.quality": {
