          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପର୍ଯ୍ୟନ୍ତ କୌଣସି ପଠନ ସଞ୍ଚିତ ହୋଇନାହିଁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ വായനകളൊന്നും സംരക്ഷിച്ചിട്ടില്ല"
          }
        }
      }
    },
    "home.learn.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore the lines, mounts and hand shapes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेखाएँ, पर्वत और हाथ के आकार जानें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেখা, পর্বত ও হাতের আকার জানুন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रेषा, पर्वत आणि हाताचे आकार जाणून घ्या"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రేఖలు, పర్వతాలు మరియు చేతి ఆకారాలను తెలుసుకోండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ரேகைகள், மேடுகள் மற்றும் கை வடிவங்களை அறியுங்கள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેખાઓ, પર્વતો અને હાથના આકાર જાણો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لکیریں، ابھار اور ہاتھ کی شکلیں جانیں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೇಖೆಗಳು, ಪರ್ವತಗಳು ಮತ್ತು ಕೈ ಆಕಾರಗಳನ್ನು ತಿಳಿಯಿರಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରେଖା, ପର୍ବତ ଓ ହାତର ଆକାର ଜାଣନ୍ତୁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖകൾ, പർവ്വതങ്ങൾ, കൈയുടെ ആകൃതികൾ എന്നിവ അറിയാം"
          }
        }
      }
    },
