    "handShape.fingers.long.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Associated with patience, attention to detail and careful thought."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धैर्य, बारीकियों पर ध्यान और सोच-समझकर विचार करने से जुड़ी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধৈর্য, খুঁটিনাটিতে মনোযোগ ও সুচিন্তিত ভাবনার সঙ্গে যুক্ত।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संयम, बारकाव्यांकडे लक्ष आणि विचारपूर्वक चिंतनाशी जोडलेली."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఓర్పు, వివరాలపై శ్రద్ధ మరియు జాగ్రత్తగా ఆలోచించడంతో ముడిపడి ఉన్నాయి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொறுமை, நுணுக்கங்களில் கவனம் மற்றும் கவனமான சிந்தனையுடன் தொடர்புடையவை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ધીરજ, વિગતો પર ધ્યાન અને વિચારપૂર્વક ચિંતન સાથે જોડાયેલી."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صبر، تفصیل پر توجہ اور سوچ سمجھ کر غور کرنے سے منسلک۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಾಳ್ಮೆ, ವಿವರಗಳತ್ತ ಗಮನ ಮತ್ತು ಎಚ್ಚರಿಕೆಯ ಚಿಂತನೆಗೆ ಸಂಬಂಧಿಸಿವೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଧୈର୍ଯ୍ୟ, ଖୁଣ୍ଟିନାଟି ପ୍ରତି ଧ୍ୟାନ ଓ ଯତ୍ନଶୀଳ ଚିନ୍ତା ସହ ଜଡ଼ିତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ഷമ, സൂക്ഷ്മാംശങ്ങളിലെ ശ്രദ്ധ, ശ്രദ്ധാപൂർവമായ ചിന്ത എന്നിവയുമായി ബന്ധപ്പെട്ടവ."
          }
        }
      }
    },
    "handShape.fingers.short": {
