    "insight.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Elemental Flow"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का तात्विक प्रवाह"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের মৌলিক প্রবাহ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजचा तत्त्व प्रवाह"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేటి మూలక ప్రవాహం"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய பூத ஓட்டம்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજનો તત્ત્વ પ્રવાહ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کا عنصری بہاؤ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದಿನ ತತ್ವ ಹರಿವು"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜିର ତତ୍ତ୍ୱ ପ୍ରବାହ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ തത്ത്വ പ്രവാഹം"
          }
        }
      }
    },
    "language.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the language for the whole app. Your readings switch instantly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे ऐप के लिए भाषा चुनें। आपकी रीडिंग तुरंत बदल जाएगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরো অ্যাপের জন্য ভাষা বেছে নিন। আপনার পাঠ সঙ্গে সঙ্গে বদলে যাবে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपूर्ण ॲपसाठी भाषा निवडा. तुमचे वाचन लगेच बदलेल."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొత్తం యాప్ కోసం భాషను ఎంచుకోండి. మీ పఠనాలు వెంటనే మారుతాయి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு ஆப்புக்கும் மொழியைத் தேர்ந்தெடுக்கவும். உங்கள் வாசிப்புகள் உடனே மாறும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આખી ઍપ માટે ભાષા પસંદ કરો. તમારા વાંચન તરત જ બદલાઈ જશે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوری ایپ کے لیے زبان منتخب کریں۔ آپ کی ریڈنگز فوراً بدل جائیں گی۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಡೀ ಆ್ಯಪ್‌ಗೆ ಭಾಷೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಓದುಗಳು ತಕ್ಷಣ ಬದಲಾಗುತ್ತವೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମଗ୍ର ଆପ୍ ପାଇଁ ଭାଷା ବାଛନ୍ତୁ। ଆପଣଙ୍କ ପଠନ ତୁରନ୍ତ ବଦଳିଯିବ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുഴുവൻ ആപ്പിനുമുള്ള ഭാഷ തിരഞ്ഞെടുക്കുക. നിങ്ങളുടെ വായനകൾ ഉടൻ മാറും."
          }
        }
      }
    },
