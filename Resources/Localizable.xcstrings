            "value": "હજી સુધી કોઈ વાંચન સાચવેલ નથી"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی ریڈنگ محفوظ نہیں ہوئی"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
