    "head.imaginative.advice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair your expansive visionary ideas with dedicated milestones and practical execution timelines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने विस्तृत दूरदर्शी विचारों को निश्चित लक्ष्यों और व्यावहारिक समय-सीमा के साथ जोड़ें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিস্তৃত দূরদর্শী ভাবনাকে নির্দিষ্ট লক্ষ্য ও বাস্তবসম্মত সময়সীমার সঙ্গে যুক্ত করুন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या विस्तृत दूरदर्शी कल्पनांना ठरावीक टप्पे आणि व्यावहारिक कालमर्यादेची जोड द्या."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ విశాలమైన దార్శనిక ఆలోచనలను నిర్దిష్ట మైలురాళ్లు మరియు ఆచరణాత్మక గడువులతో జత చేయండి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் விரிந்த தொலைநோக்குச் சிந்தனைகளை உறுதியான இலக்குகளுடனும் நடைமுறைக் காலக்கெடுவுடனும் இணைக்கவும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા વિશાળ દૂરદર્શી વિચારોને નિશ્ચિત લક્ષ્યો અને વ્યવહારુ સમયમર્યાદા સાથે જોડો."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے وسیع دور اندیش خیالات کو واضح سنگِ میل اور عملی ٹائم لائن کے ساتھ جوڑیں۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವಿಶಾಲ ದಾರ್ಶನಿಕ ಆಲೋಚನೆಗಳನ್ನು ನಿರ್ದಿಷ್ಟ ಮೈಲಿಗಲ್ಲುಗಳು ಮತ್ತು ಪ್ರಾಯೋಗಿಕ ಕಾಲಮಿತಿಗಳೊಂದಿಗೆ ಜೋಡಿಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବିସ୍ତୃତ ଦୂରଦର୍ଶୀ ଚିନ୍ତାକୁ ନିର୍ଦ୍ଦିଷ୍ଟ ଲକ୍ଷ୍ୟ ଓ ବ୍ୟାବହାରିକ ସମୟସୀମା ସହ ଯୋଡ଼ନ୍ତୁ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വിശാലമായ ദീർഘവീക്ഷണ ആശയങ്ങളെ വ്യക്തമായ നാഴികക്കല്ലുകളും പ്രായോഗിക സമയപരിധികളുമായി ചേർക്കുക."
          }
        }
      }
    },
    "head.imaginative.detailed.left": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your intellect flourishes beyond rigid boundaries. You synthesize patterns, visualize multidimensional solutions, and possess natural aptitude for design, writing, philosophy, or innovative architecture. On the Left Hand, this indicates that your innate instinct is highly imaginative and perceptual."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी बुद्धि कठोर सीमाओं से परे फलती-फूलती है। आप पैटर्न जोड़ते हैं, बहुआयामी समाधानों की कल्पना करते हैं और डिज़ाइन, लेखन, दर्शन या नवीन वास्तुकला में स्वाभाविक योग्यता रखते हैं। बाएँ हाथ पर यह दर्शाता है कि आपकी जन्मजात प्रवृत्ति अत्यंत कल्पनाशील और संवेदनशील है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বুদ্ধি কঠোর সীমার বাইরে বিকশিত হয়। আপনি নকশা মেলান, বহুমাত্রিক সমাধান কল্পনা করেন এবং ডিজাইন, লেখা, দর্শন বা উদ্ভাবনী স্থাপত্যে স্বাভাবিক দক্ষতা রাখেন। বাঁ হাতে এটি নির্দেশ করে যে আপনার সহজাত প্রবৃত্তি অত্যন্ত কল্পনাপ্রবণ ও সংবেদনশীল।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची बुद्धी कठोर मर्यादांच्या पलीकडे बहरते. तुम्ही नमुने जोडता, बहुआयामी उपायांची कल्पना करता आणि डिझाइन, लेखन, तत्त्वज्ञान किंवा नावीन्यपूर्ण वास्तुकलेत नैसर्गिक कल ठेवता. डाव्या हातावर हे दर्शवते की तुमची जन्मजात प्रवृत्ती अत्यंत कल्पक आणि संवेदनशील आहे."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ బుద్ధి కఠినమైన హద్దులకు అతీతంగా వికసిస్తుంది. మీరు నమూనాలను కలుపుతారు, బహుముఖ పరిష్కారాలను ఊహిస్తారు మరియు డిజైన్, రచన, తత్వశాస్త్రం లేదా వినూత్న వాస్తుశిల్పంలో సహజ ప్రావీణ్యం కలిగి ఉంటారు. ఎడమ చేతిపై ఇది మీ సహజ ప్రవృత్తి అత్యంత ఊహాత్మకంగా మరియు సున్నితంగా ఉంటుందని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அறிவு கடுமையான எல்லைகளைத் தாண்டி மலர்கிறது. நீங்கள் வடிவங்களை இணைக்கிறீர்கள், பல பரிமாணத் தீர்வுகளைக் கற்பனை செய்கிறீர்கள்; வடிவமைப்பு, எழுத்து, தத்துவம் அல்லது புதுமையான கட்டிடக்கலையில் இயல்பான திறன் கொண்டவர். இடது கையில் இது உங்கள் பிறவி உள்ளுணர்வு மிகுந்த கற்பனையும் நுண்ணுணர்வும் கொண்டது என்பதைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી બુદ્ધિ કઠોર સીમાઓથી પર ખીલે છે. તમે પૅટર્ન જોડો છો, બહુપરિમાણીય ઉકેલોની કલ્પના કરો છો અને ડિઝાઇન, લેખન, તત્ત્વજ્ઞાન કે નવીન સ્થાપત્યમાં સ્વાભાવિક યોગ્યતા ધરાવો છો. ડાબા હાથ પર આ દર્શાવે છે કે તમારી જન્મજાત વૃત્તિ અત્યંત કલ્પનાશીલ અને સંવેદનશીલ છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ذہانت سخت حدود سے آگے پھلتی پھولتی ہے۔ آپ نمونوں کو جوڑتے ہیں، کثیر جہتی حل تصور کرتے ہیں اور ڈیزائن، تحریر، فلسفے یا جدید فنِ تعمیر میں فطری مہارت رکھتے ہیں۔ بائیں ہاتھ پر یہ ظاہر کرتی ہے کہ آپ کی فطری جبلت نہایت تخیلاتی اور حساس ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬುದ್ಧಿಯು ಕಠಿಣ ಗಡಿಗಳನ್ನು ಮೀರಿ ಅರಳುತ್ತದೆ. ನೀವು ಮಾದರಿಗಳನ್ನು ಬೆಸೆಯುತ್ತೀರಿ, ಬಹುಆಯಾಮದ ಪರಿಹಾರಗಳನ್ನು ಕಲ್ಪಿಸುತ್ತೀರಿ ಮತ್ತು ವಿನ್ಯಾಸ, ಬರವಣಿಗೆ, ತತ್ವಶಾಸ್ತ್ರ ಅಥವಾ ನವೀನ ವಾಸ್ತುಶಿಲ್ಪದಲ್ಲಿ ಸಹಜ ಪ್ರತಿಭೆ ಹೊಂದಿದ್ದೀರಿ. ಎಡಗೈಯಲ್ಲಿ ಇದು ನಿಮ್ಮ ಸಹಜ ಪ್ರವೃತ್ತಿ ಅತ್ಯಂತ ಕಲ್ಪನಾಶೀಲ ಮತ್ತು ಸೂಕ್ಷ್ಮಗ್ರಾಹಿಯಾಗಿದೆ ಎಂದು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବୁଦ୍ଧି କଠୋର ସୀମା ବାହାରେ ବିକଶିତ ହୁଏ। ଆପଣ ନମୁନାକୁ ଯୋଡ଼ନ୍ତି, ବହୁମାତ୍ରିକ ସମାଧାନ କଳ୍ପନା କରନ୍ତି ଏବଂ ଡିଜାଇନ, ଲେଖା, ଦର୍ଶନ କିମ୍ବା ଅଭିନବ ସ୍ଥାପତ୍ୟରେ ସ୍ୱାଭାବିକ ଦକ୍ଷତା ରଖନ୍ତି। ବାମ ହାତରେ ଏହା ସୂଚାଏ ଯେ ଆପଣଙ୍କ ଜନ୍ମଗତ ପ୍ରବୃତ୍ତି ଅତ୍ୟନ୍ତ କଳ୍ପନାଶୀଳ ଓ ସମ୍ବେଦନଶୀଳ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ബുദ്ധി കർശനമായ അതിരുകൾക്കപ്പുറം വിരിയുന്നു. നിങ്ങൾ മാതൃകകളെ സമന്വയിപ്പിക്കുന്നു, ബഹുമാന പരിഹാരങ്ങൾ വിഭാവനം ചെയ്യുന്നു, ഡിസൈൻ, എഴുത്ത്, തത്ത്വചിന്ത അല്ലെങ്കിൽ നൂതന വാസ്തുവിദ്യ എന്നിവയിൽ സ്വാഭാവിക അഭിരുചിയുണ്ട്. ഇടതു കൈയിൽ ഇത് നിങ്ങളുടെ ജന്മസിദ്ധമായ സഹജവാസന അതീവ ഭാവനാസമ്പന്നവും സൂക്ഷ്മഗ്രാഹിയുമാണെന്ന് സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
    "head.imaginative.detailed.right": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your intellect flourishes beyond rigid boundaries. You synthesize patterns, visualize multidimensional solutions, and possess natural aptitude for design, writing, philosophy, or innovative architecture. On the Right Hand, this indicates that your active work style synthesizes vision with strategic planning."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी बुद्धि कठोर सीमाओं से परे फलती-फूलती है। आप पैटर्न जोड़ते हैं, बहुआयामी समाधानों की कल्पना करते हैं और डिज़ाइन, लेखन, दर्शन या नवीन वास्तुकला में स्वाभाविक योग्यता रखते हैं। दाएँ हाथ पर यह दर्शाता है कि आपकी सक्रिय कार्यशैली दूरदृष्टि को रणनीतिक योजना से जोड़ती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বুদ্ধি কঠোর সীমার বাইরে বিকশিত হয়। আপনি নকশা মেলান, বহুমাত্রিক সমাধান কল্পনা করেন এবং ডিজাইন, লেখা, দর্শন বা উদ্ভাবনী স্থাপত্যে স্বাভাবিক দক্ষতা রাখেন। ডান হাতে এটি নির্দেশ করে যে আপনার সক্রিয় কর্মধারা দূরদৃষ্টিকে কৌশলগত পরিকল্পনার সঙ্গে মেলায়।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची बुद्धी कठोर मर्यादांच्या पलीकडे बहरते. तुम्ही नमुने जोडता, बहुआयामी उपायांची कल्पना करता आणि डिझाइन, लेखन, तत्त्वज्ञान किंवा नावीन्यपूर्ण वास्तुकलेत नैसर्गिक कल ठेवता. उजव्या हातावर हे दर्शवते की तुमची सक्रिय कार्यशैली दूरदृष्टीला धोरणात्मक नियोजनाशी जोडते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ బుద్ధి కఠినమైన హద్దులకు అతీతంగా వికసిస్తుంది. మీరు నమూనాలను కలుపుతారు, బహుముఖ పరిష్కారాలను ఊహిస్తారు మరియు డిజైన్, రచన, తత్వశాస్త్రం లేదా వినూత్న వాస్తుశిల్పంలో సహజ ప్రావీణ్యం కలిగి ఉంటారు. కుడి చేతిపై ఇది మీ క్రియాశీల పని శైలి దూరదృష్టిని వ్యూహాత్మక ప్రణాళికతో మేళవిస్తుందని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அறிவு கடுமையான எல்லைகளைத் தாண்டி மலர்கிறது. நீங்கள் வடிவங்களை இணைக்கிறீர்கள், பல பரிமாணத் தீர்வுகளைக் கற்பனை செய்கிறீர்கள்; வடிவமைப்பு, எழுத்து, தத்துவம் அல்லது புதுமையான கட்டிடக்கலையில் இயல்பான திறன் கொண்டவர். வலது கையில் இது உங்கள் செயல்படும் பணிமுறை தொலைநோக்கை உத்திசார் திட்டமிடலுடன் இணைக்கிறது என்பதைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી બુદ્ધિ કઠોર સીમાઓથી પર ખીલે છે. તમે પૅટર્ન જોડો છો, બહુપરિમાણીય ઉકેલોની કલ્પના કરો છો અને ડિઝાઇન, લેખન, તત્ત્વજ્ઞાન કે નવીન સ્થાપત્યમાં સ્વાભાવિક યોગ્યતા ધરાવો છો. જમણા હાથ પર આ દર્શાવે છે કે તમારી સક્રિય કાર્યશૈલી દૂરદૃષ્ટિને વ્યૂહાત્મક આયોજન સાથે જોડે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ذہانت سخت حدود سے آگے پھلتی پھولتی ہے۔ آپ نمونوں کو جوڑتے ہیں، کثیر جہتی حل تصور کرتے ہیں اور ڈیزائن، تحریر، فلسفے یا جدید فنِ تعمیر میں فطری مہارت رکھتے ہیں۔ دائیں ہاتھ پر یہ ظاہر کرتی ہے کہ آپ کا فعال طرزِ کار دور اندیشی کو حکمتِ عملی کی منصوبہ بندی سے جوڑتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬುದ್ಧಿಯು ಕಠಿಣ ಗಡಿಗಳನ್ನು ಮೀರಿ ಅರಳುತ್ತದೆ. ನೀವು ಮಾದರಿಗಳನ್ನು ಬೆಸೆಯುತ್ತೀರಿ, ಬಹುಆಯಾಮದ ಪರಿಹಾರಗಳನ್ನು ಕಲ್ಪಿಸುತ್ತೀರಿ ಮತ್ತು ವಿನ್ಯಾಸ, ಬರವಣಿಗೆ, ತತ್ವಶಾಸ್ತ್ರ ಅಥವಾ ನವೀನ ವಾಸ್ತುಶಿಲ್ಪದಲ್ಲಿ ಸಹಜ ಪ್ರತಿಭೆ ಹೊಂದಿದ್ದೀರಿ. ಬಲಗೈಯಲ್ಲಿ ಇದು ನಿಮ್ಮ ಸಕ್ರಿಯ ಕಾರ್ಯಶೈಲಿ ದೂರದೃಷ್ಟಿಯನ್ನು ಕಾರ್ಯತಂತ್ರದ ಯೋಜನೆಯೊಂದಿಗೆ ಬೆಸೆಯುತ್ತದೆ ಎಂದು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବୁଦ୍ଧି କଠୋର ସୀମା ବାହାରେ ବିକଶିତ ହୁଏ। ଆପଣ ନମୁନାକୁ ଯୋଡ଼ନ୍ତି, ବହୁମାତ୍ରିକ ସମାଧାନ କଳ୍ପନା କରନ୍ତି ଏବଂ ଡିଜାଇନ, ଲେଖା, ଦର୍ଶନ କିମ୍ବା ଅଭିନବ ସ୍ଥାପତ୍ୟରେ ସ୍ୱାଭାବିକ ଦକ୍ଷତା ରଖନ୍ତି। ଡାହାଣ ହାତରେ ଏହା ସୂଚାଏ ଯେ ଆପଣଙ୍କ ସକ୍ରିୟ କାର୍ଯ୍ୟଶୈଳୀ ଦୂରଦୃଷ୍ଟିକୁ କୌଶଳଗତ ଯୋଜନା ସହ ଯୋଡ଼େ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ബുദ്ധി കർശനമായ അതിരുകൾക്കപ്പുറം വിരിയുന്നു. നിങ്ങൾ മാതൃകകളെ സമന്വയിപ്പിക്കുന്നു, ബഹുമാന പരിഹാരങ്ങൾ വിഭാവനം ചെയ്യുന്നു, ഡിസൈൻ, എഴുത്ത്, തത്ത്വചിന്ത അല്ലെങ്കിൽ നൂതന വാസ്തുവിദ്യ എന്നിവയിൽ സ്വാഭാവിക അഭിരുചിയുണ്ട്. വലതു കൈയിൽ ഇത് നിങ്ങളുടെ സജീവ പ്രവർത്തനശൈലി ദീർഘവീക്ഷണത്തെ തന്ത്രപരമായ ആസൂത്രണവുമായി സമന്വയിപ്പിക്കുന്നുവെന്ന് സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
    "head.imaginative.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A head line gently inclining toward the Lunar mount denotes deep lateral problem solving, creative intuition, and vision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंद्र पर्वत की ओर हल्का झुकी मस्तिष्क रेखा गहरी रचनात्मक समस्या-समाधान क्षमता, सृजनात्मक अंतर्ज्ञान और दूरदर्शिता को दर्शाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চন্দ্র পর্বতের দিকে সামান্য হেলানো মস্তিষ্ক রেখা গভীর সৃজনশীল সমস্যা-সমাধান, অন্তর্দৃষ্টি ও দূরদৃষ্টি নির্দেশ করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चंद्र पर्वताकडे हलकेच झुकलेली मस्तक रेषा सखोल सर्जनशील समस्या-निवारण, अंतःप्रेरणा आणि दूरदृष्टी दर्शवते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చంద్ర పర్వతం వైపు కొద్దిగా వంగిన మస్తిష్క రేఖ లోతైన సృజనాత్మక సమస్య పరిష్కారం, అంతర్బుద్ధి మరియు దూరదృష్టిని సూచిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சந்திர மேட்டை நோக்கிச் சற்றுச் சாயும் புத்தி ரேகை ஆழ்ந்த படைப்புச் சிக்கல் தீர்வு, உள்ளுணர்வு மற்றும் தொலைநோக்கைக் குறிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચંદ્ર પર્વત તરફ સહેજ ઝૂકેલી મસ્તિષ્ક રેખા ઊંડી સર્જનાત્મક સમસ્યા-ઉકેલ ક્ષમતા, અંતઃસ્ફુરણા અને દૂરદૃષ્ટિ દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قمر کے ابھار کی طرف ہلکی سی جھکی ہوئی دماغ کی لکیر گہری تخلیقی مسئلہ حل کرنے کی صلاحیت، وجدان اور دور اندیشی ظاہر کرتی ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಂದ್ರ ಪರ್ವತದ ಕಡೆಗೆ ಸ್ವಲ್ಪ ಬಾಗಿದ ಮಸ್ತಿಷ್ಕ ರೇಖೆಯು ಆಳವಾದ ಸೃಜನಶೀಲ ಸಮಸ್ಯೆ ಪರಿಹಾರ, ಅಂತಃಪ್ರಜ್ಞೆ ಮತ್ತು ದೂರದೃಷ್ಟಿಯನ್ನು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଚନ୍ଦ୍ର ପର୍ବତ ଆଡ଼କୁ ଟିକେ ଢଳିଥିବା ମସ୍ତିଷ୍କ ରେଖା ଗଭୀର ସୃଜନଶୀଳ ସମସ୍ୟା ସମାଧାନ, ଅନ୍ତର୍ଜ୍ଞାନ ଓ ଦୂରଦୃଷ୍ଟି ସୂଚାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചന്ദ്ര പർവ്വതത്തിലേക്ക് അൽപ്പം ചരിഞ്ഞ ശിരോരേഖ ആഴമുള്ള സർഗാത്മക പ്രശ്നപരിഹാരം, അന്തർജ്ഞാനം, ദീർഘവീക്ഷണം എന്നിവ സൂചിപ്പിക്കുന്നു."
          }
        }
      }
    },
    "head.imaginative.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginative & Conceptual Genius"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल्पनाशील और वैचारिक प्रतिभा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কল্পনাপ্রবণ ও ধারণাগত প্রতিভা"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कल्पक आणि वैचारिक प्रतिभा"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఊహాత్మక మరియు భావనాత్మక ప్రతిభ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கற்பனைமிக்க மற்றும் கருத்தியல் மேதைமை"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કલ્પનાશીલ અને વૈચારિક પ્રતિભા"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تخیلاتی اور فکری ذہانت"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಲ್ಪನಾಶೀಲ ಮತ್ತು ಪರಿಕಲ್ಪನಾತ್ಮಕ ಪ್ರತಿಭೆ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କଳ୍ପନାଶୀଳ ଓ ଧାରଣାତ୍ମକ ପ୍ରତିଭା"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഭാവനാസമ്പന്നവും ആശയപരവുമായ പ്രതിഭ"
          }
        }
      }
    },
