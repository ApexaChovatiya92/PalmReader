    "handShape.little.long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaches the ring finger's top joint"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनामिका के ऊपरी जोड़ तक पहुँचती है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনামিকার উপরের গাঁট পর্যন্ত পৌঁছায়"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनामिकेच्या वरच्या सांध्यापर्यंत पोहोचते"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉంగరపు వేలి పై కీలు వరకు చేరుతుంది"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மோதிர விரலின் மேல் மூட்டு வரை எட்டுகிறது"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનામિકાના ઉપરના સાંધા સુધી પહોંચે છે"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انگوٹھی والی انگلی کے اوپری جوڑ تک پہنچتی ہے"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಂಗುರದ ಬೆರಳಿನ ಮೇಲಿನ ಕೀಲಿನವರೆಗೆ ತಲುಪುತ್ತದೆ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନାମିକାର ଉପର ଗଣ୍ଠି ପର୍ଯ୍ୟନ୍ତ ପହଞ୍ଚେ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോതിരവിരലിന്റെ മുകളിലെ സന്ധി വരെ എത്തുന്നു"
          }
        }
      }
    },
    "handShape.little.long.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A well-developed Mercury finger: traditionally a sign of a persuasive, articulate communicator."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विकसित बुध उंगली: परंपरागत रूप से प्रभावशाली और मुखर वक्ता का संकेत।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুবিকশিত বুধের আঙুল: ঐতিহ্যগতভাবে প্রভাবশালী, বাকপটু বক্তার চিহ্ন।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विकसित बुध बोट: परंपरेनुसार प्रभावी आणि बोलक्या वक्त्याचे चिन्ह."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బాగా అభివృద్ధి చెందిన బుధ వేలు: సంప్రదాయంగా ఒప్పించగల, మాటకారి వక్తకు సంకేతం."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நன்கு வளர்ந்த புதன் விரல்: மரபுப்படி நம்பவைக்கும், சொல்வன்மை மிக்க பேச்சாளரின் அடையாளம்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિકસિત બુધ આંગળી: પરંપરાગત રીતે પ્રભાવશાળી અને વાક્પટુ વક્તાનો સંકેત."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اچھی طرح نشوونما پائی عطارد کی انگلی: روایتی طور پر قائل کرنے والے، خوش گفتار مقرر کی علامت۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚೆನ್ನಾಗಿ ಬೆಳೆದ ಬುಧ ಬೆರಳು: ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಮನವೊಲಿಸುವ, ಮಾತುಗಾರ ವಾಗ್ಮಿಯ ಸಂಕೇತ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିକଶିତ ବୁଧ ଆଙ୍ଗୁଠି: ପରମ୍ପରା ଅନୁସାରେ ପ୍ରଭାବଶାଳୀ, ବାକ୍‌ପଟୁ ବକ୍ତାର ସଙ୍କେତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നന്നായി വികസിച്ച ബുധന്റെ വിരൽ: പരമ്പരാഗതമായി ബോധ്യപ്പെടുത്താൻ കഴിവുള്ള, വാക്ചാതുര്യമുള്ള വക്താവിന്റെ ചിഹ്നം."
          }
        }
      }
    },
    "handShape.little.short": {
      "extractionState": "manual",
      "localizations": {
