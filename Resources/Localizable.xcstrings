    "element.fire.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long palm with shorter fingers. Traditionally energetic, bold and spontaneous, with a natural spark of leadership."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबी हथेली और छोटी उंगलियाँ। परंपरागत रूप से ऊर्जावान, साहसी और सहज, स्वाभाविक नेतृत्व की चमक के साथ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লম্বা তালু ও ছোট আঙুল। ঐতিহ্যগতভাবে উদ্যমী, সাহসী ও স্বতঃস্ফূর্ত, স্বাভাবিক নেতৃত্বের দীপ্তিসহ।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लांब तळहात आणि लहान बोटे. परंपरेनुसार उत्साही, धाडसी आणि उत्स्फूर्त, नैसर्गिक नेतृत्वाच्या चमकेसह."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పొడవైన అరచేతి, పొట్టి వేళ్లు. సంప్రదాయంగా ఉత్సాహవంతులు, ధైర్యవంతులు, సహజంగా స్పందించేవారు, సహజ నాయకత్వ మెరుపుతో."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீண்ட உள்ளங்கை, குட்டையான விரல்கள். மரபுப்படி ஆற்றல் மிக்கவர்கள், துணிச்சலானவர்கள், தன்னிச்சையானவர்கள், இயல்பான தலைமைப் பொறியுடன்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાંબી હથેળી અને ટૂંકી આંગળીઓ. પરંપરાગત રીતે ઊર્જાવાન, હિંમતવાન અને સહજ, સ્વાભાવિક નેતૃત્વની ચમક સાથે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لمبی ہتھیلی اور چھوٹی انگلیاں۔ روایتی طور پر پرجوش، بہادر اور بے ساختہ، فطری قیادت کی چمک کے ساتھ۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉದ್ದ ಅಂಗೈ ಮತ್ತು ಗಿಡ್ಡ ಬೆರಳುಗಳು. ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಉತ್ಸಾಹಿ, ಧೈರ್ಯಶಾಲಿ ಮತ್ತು ಸಹಜ ಸ್ಫೂರ್ತಿಯವರು, ಸಹಜ ನಾಯಕತ್ವದ ಹೊಳಪಿನೊಂದಿಗೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲମ୍ବା ପାପୁଲି ଓ ଛୋଟ ଆଙ୍ଗୁଠି। ପରମ୍ପରା ଅନୁସାରେ ଉତ୍ସାହୀ, ସାହସୀ ଓ ସ୍ୱତଃସ୍ଫୂର୍ତ୍ତ, ସ୍ୱାଭାବିକ ନେତୃତ୍ୱର ଝଲକ ସହ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീണ്ട കൈപ്പത്തിയും നീളം കുറഞ്ഞ വിരലുകളും. പരമ്പരാഗതമായി ഊർജ്ജസ്വലർ, ധീരർ, സ്വാഭാവികമായി പ്രതികരിക്കുന്നവർ, സ്വാഭാവിക നേതൃത്വത്തിന്റെ തിളക്കത്തോടെ."
          }
        }
      }
    },
