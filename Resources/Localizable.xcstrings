    },
    "guidance.alignUpright": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align palm vertically upright"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हथेली को सीधा खड़ा रखें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তালু সোজা খাড়া রাখুন"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तळहात सरळ उभा ठेवा"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అరచేతిని నిటారుగా ఉంచండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளங்கையை நேராக நிமிர்த்தி வைக்கவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હથેળીને સીધી ઊભી રાખો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہتھیلی کو سیدھا کھڑا رکھیں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂಗೈಯನ್ನು ನೇರವಾಗಿ ನಿಲ್ಲಿಸಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାପୁଲିକୁ ସିଧା ଠିଆ କରି ରଖନ୍ତୁ"
          }
