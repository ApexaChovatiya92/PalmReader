    "marking.fork.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Writer's Fork merges imaginative conceptualization with pragmatic logical articulation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक की द्विशाखा कल्पनाशील सोच को व्यावहारिक और तार्किक अभिव्यक्ति से जोड़ती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেখকের দ্বিশাখা কল্পনাশীল ভাবনাকে বাস্তবসম্মত, যুক্তিপূর্ণ প্রকাশের সঙ্গে মেলায়।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखकाची द्विशाखा कल्पक विचारांना व्यावहारिक, तार्किक मांडणीशी जोडते."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రచయిత చీలిక ఊహాత్మక ఆలోచనను ఆచరణాత్మక, తార్కిక వ్యక్తీకరణతో కలుపుతుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்தாளரின் கிளைப்பிரிவு கற்பனைச் சிந்தனையை நடைமுறை, தர்க்கரீதியான வெளிப்பாட்டுடன் இணைக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લેખકની દ્વિશાખા કલ્પનાશીલ વિચારને વ્યવહારુ, તાર્કિક અભિવ્યક્તિ સાથે જોડે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مصنف کا دو شاخہ تخیلاتی سوچ کو عملی اور منطقی اظہار سے جوڑتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೇಖಕರ ಕವಲು ಕಲ್ಪನಾಶೀಲ ಚಿಂತನೆಯನ್ನು ಪ್ರಾಯೋಗಿಕ, ತಾರ್ಕಿಕ ಅಭಿವ್ಯಕ್ತಿಯೊಂದಿಗೆ ಬೆಸೆಯುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲେଖକଙ୍କ ଦ୍ୱିଶାଖା କଳ୍ପନାଶୀଳ ଚିନ୍ତାକୁ ବ୍ୟାବହାରିକ ଓ ତାର୍କିକ ପ୍ରକାଶ ସହ ଯୋଡ଼େ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എഴുത്തുകാരന്റെ ശാഖാവിഭജനം ഭാവനാത്മക ചിന്തയെ പ്രായോഗികവും യുക്തിസഹവുമായ ആവിഷ്കാരവുമായി ബന്ധിപ്പിക്കുന്നു."
          }
        }
      }
    },
