    "history.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readings you save will appear here offline with full line overlays and metric breakdowns."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सहेजी गई रीडिंग यहाँ रेखाओं और मापों के पूरे विवरण के साथ ऑफ़लाइन दिखाई देंगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সংরক্ষিত পাঠগুলি এখানে রেখা ও পরিমাপের সম্পূর্ণ বিবরণসহ অফলাইনে দেখা যাবে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जतन केलेली वाचने येथे रेषा आणि मोजमापांच्या पूर्ण तपशीलासह ऑफलाइन दिसतील."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సేవ్ చేసిన పఠనాలు రేఖలు మరియు కొలతల పూర్తి వివరాలతో ఇక్కడ ఆఫ్‌లైన్‌లో కనిపిస్తాయి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சேமிக்கும் வாசிப்புகள் ரேகைகள் மற்றும் அளவீடுகளின் முழு விவரங்களுடன் இங்கே ஆஃப்லைனில் தோன்றும்."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સાચવેલાં વાંચન અહીં રેખાઓ અને માપના સંપૂર્ણ વિવરણ સાથે ઑફલાઇન દેખાશે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی محفوظ کردہ ریڈنگز یہاں لکیروں اور پیمائشوں کی مکمل تفصیل کے ساتھ آف لائن نظر آئیں گی۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಉಳಿಸುವ ಓದುಗಳು ರೇಖೆಗಳು ಮತ್ತು ಅಳತೆಗಳ ಸಂಪೂರ್ಣ ವಿವರಗಳೊಂದಿಗೆ ಇಲ್ಲಿ ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ସଞ୍ଚୟ କରୁଥିବା ପଠନ ଏଠାରେ ରେଖା ଓ ମାପର ସମ୍ପୂର୍ଣ୍ଣ ବିବରଣୀ ସହ ଅଫଲାଇନରେ ଦେଖାଯିବ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സംരക്ഷിക്കുന്ന വായനകൾ രേഖകളുടെയും അളവുകളുടെയും പൂർണ്ണ വിവരങ്ങളോടെ ഇവിടെ ഓഫ്‌ലൈനായി കാണാം."
          }
        }
      }
    },
