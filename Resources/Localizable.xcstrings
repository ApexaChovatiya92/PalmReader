          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಹತ್ವಾಕಾಂಕ್ಷೆ ಮತ್ತು ನಾಯಕತ್ವ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉଚ୍ଚାକାଂକ୍ଷା ଓ ନେତୃତ୍ୱ"
          }
        },
        "ml": {
          "stringUnit": {
