          }
        }
      }
    },
    "learn.topic.shapes.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Palmists group hands into four elements by the shape of the palm and the length of the fingers. A square palm is about as wide as it is tall; a long palm is clearly taller than it is wide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्तरेखा विशेषज्ञ हथेली के आकार और उंगलियों की लंबाई के आधार पर हाथों को चार तत्वों में बाँटते हैं। वर्गाकार हथेली लगभग उतनी ही चौड़ी होती है जितनी लंबी; लंबी हथेली चौड़ाई से साफ़ तौर पर अधिक लंबी होती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হস্তরেখাবিদরা তালুর আকার ও আঙুলের দৈর্ঘ্য দেখে হাতকে চারটি উপাদানে ভাগ করেন। বর্গাকার তালু প্রায় যতটা লম্বা ততটাই চওড়া; লম্বা তালু চওড়ার চেয়ে স্পষ্টভাবে বেশি লম্বা।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्तरेषा तज्ज्ञ तळहाताचा आकार आणि बोटांची लांबी यांवरून हातांचे चार तत्त्वांमध्ये वर्गीकरण करतात. चौकोनी तळहात जवळपास जितका लांब तितकाच रुंद असतो; लांब तळहात रुंदीपेक्षा स्पष्टपणे जास्त लांब असतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హస్తరేఖా నిపుణులు అరచేతి ఆకారం మరియు వేళ్ల పొడవు ఆధారంగా చేతులను నాలుగు మూలకాలుగా విభజిస్తారు. చతురస్రాకార అరచేతి దాదాపు పొడవుకు సమానమైన వెడల్పుతో ఉంటుంది; పొడవైన అరచేతి వెడల్పు కంటే స్పష్టంగా ఎక్కువ పొడవుగా ఉంటుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைரேகை நிபுணர்கள் உள்ளங்கையின் வடிவம் மற்றும் விரல்களின் நீளத்தைக் கொண்டு கைகளை நான்கு பூதங்களாகப் பிரிக்கிறார்கள். சதுர உள்ளங்கை ஏறக்குறைய நீளத்துக்குச் சமமான அகலம் கொண்டது; நீண்ட உள்ளங்கை அகலத்தை விடத் தெளிவாக நீளமானது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હસ્તરેખા નિષ્ણાતો હથેળીના આકાર અને આંગળીઓની લંબાઈના આધારે હાથોને ચાર તત્ત્વોમાં વહેંચે છે. ચોરસ હથેળી લગભગ જેટલી લાંબી તેટલી જ પહોળી હોય છે; લાંબી હથેળી પહોળાઈ કરતાં સ્પષ્ટ રીતે વધુ લાંબી હોય છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دست شناس ہتھیلی کی شکل اور انگلیوں کی لمبائی کی بنیاد پر ہاتھوں کو چار عناصر میں تقسیم کرتے ہیں۔ چوکور ہتھیلی تقریباً اتنی ہی چوڑی ہوتی ہے جتنی لمبی؛ لمبی ہتھیلی چوڑائی سے واضح طور پر زیادہ لمبی ہوتی ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಸ್ತಸಾಮುದ್ರಿಕ ತಜ್ಞರು ಅಂಗೈಯ ಆಕಾರ ಮತ್ತು ಬೆರಳುಗಳ ಉದ್ದದ ಆಧಾರದಲ್ಲಿ ಕೈಗಳನ್ನು ನಾಲ್ಕು ತತ್ವಗಳಾಗಿ ವಿಂಗಡಿಸುತ್ತಾರೆ. ಚೌಕ ಅಂಗೈ ಸುಮಾರು ಉದ್ದದಷ್ಟೇ ಅಗಲವಾಗಿರುತ್ತದೆ; ಉದ್ದ ಅಂಗೈ ಅಗಲಕ್ಕಿಂತ ಸ್ಪಷ್ಟವಾಗಿ ಹೆಚ್ಚು ಉದ್ದವಾಗಿರುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହସ୍ତରେଖା ବିଶେଷଜ୍ଞମାନେ ପାପୁଲିର ଆକାର ଓ ଆଙ୍ଗୁଠିର ଦୈର୍ଘ୍ୟ ଆଧାରରେ ହାତକୁ ଚାରି ତତ୍ତ୍ୱରେ ବିଭକ୍ତ କରନ୍ତି। ବର୍ଗାକାର ପାପୁଲି ପ୍ରାୟ ଯେତିକି ଲମ୍ବା ସେତିକି ଓସାରିଆ; ଲମ୍ବା ପାପୁଲି ଓସାର ଠାରୁ ସ୍ପଷ୍ଟ ଭାବେ ଅଧିକ ଲମ୍ବା।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹസ്തരേഖാ വിദഗ്ധർ കൈപ്പത്തിയുടെ ആകൃതിയും വിരലുകളുടെ നീളവും അനുസരിച്ച് കൈകളെ നാല് തത്ത്വങ്ങളായി തിരിക്കുന്നു. ചതുര കൈപ്പത്തിക്ക് ഏകദേശം നീളത്തിനൊപ്പം വീതിയുണ്ട്; നീണ്ട കൈപ്പത്തി വീതിയേക്കാൾ വ്യക്തമായി നീളം കൂടിയതാണ്."
          }
        }
      }
    },
    "learn.topic.shapes.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand Shapes & Elements"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथ के आकार और तत्व"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাতের আকার ও উপাদান"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हाताचे आकार आणि तत्त्वे"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతి ఆకారాలు & మూలకాలు"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கை வடிவங்கள் & பூதங்கள்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથના આકાર અને તત્ત્વો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاتھ کی شکلیں اور عناصر"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೈ ಆಕಾರಗಳು ಮತ್ತು ತತ್ವಗಳು"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହାତର ଆକାର ଓ ତତ୍ତ୍ୱ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൈയുടെ ആകൃതികളും തത്ത്വങ്ങളും"
          }
        }
      }
    },
    "learn.topics.header": {
