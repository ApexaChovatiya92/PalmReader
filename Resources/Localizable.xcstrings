    "marking.triangle.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount of Jupiter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरु पर्वत"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বৃহস্পতি পর্বত"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गुरु पर्वत"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గురు పర్వతం"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரு மேடு"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગુરુ પર્વત"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشتری کا ابھار"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುರು ಪರ್ವತ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୁରୁ ପର୍ବତ"
          }
        },
        "ml": {
          "stringUnit": {
