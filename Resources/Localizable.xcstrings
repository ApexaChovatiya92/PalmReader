    "handShape.palm.long.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionally linked with sensitivity, imagination and a reflective nature."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरागत रूप से संवेदनशीलता, कल्पना और चिंतनशील स्वभाव से जुड़ी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐতিহ্যগতভাবে সংবেদনশীলতা, কল্পনা ও চিন্তাশীল স্বভাবের সঙ্গে যুক্ত।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परंपरेनुसार संवेदनशीलता, कल्पकता आणि चिंतनशील स्वभावाशी जोडलेला."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంప్రదాయంగా సున్నితత్వం, ఊహాశక్తి మరియు చింతనాశీల స్వభావంతో ముడిపడి ఉంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மரபுப்படி நுண்ணுணர்வு, கற்பனை மற்றும் சிந்தனை இயல்புடன் தொடர்புடையது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરંપરાગત રીતે સંવેદનશીલતા, કલ્પના અને ચિંતનશીલ સ્વભાવ સાથે જોડાયેલી."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روایتی طور پر حساسیت، تخیل اور غور و فکر والے مزاج سے منسلک۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪ್ರದಾಯದ ಪ್ರಕಾರ ಸೂಕ್ಷ್ಮತೆ, ಕಲ್ಪನೆ ಮತ್ತು ಚಿಂತನಶೀಲ ಸ್ವಭಾವಕ್ಕೆ ಸಂಬಂಧಿಸಿದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରମ୍ପରା ଅନୁସାରେ ସମ୍ବେଦନଶୀଳତା, କଳ୍ପନା ଓ ଚିନ୍ତାଶୀଳ ସ୍ୱଭାବ ସହ ଜଡ଼ିତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമ്പരാഗതമായി സംവേദനക്ഷമത, ഭാവന, ചിന്താശീല സ്വഭാവം എന്നിവയുമായി ബന്ധപ്പെട്ടത്."
          }
        }
      }
    },
