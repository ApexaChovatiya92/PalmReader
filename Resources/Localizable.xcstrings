        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి మీ ఎడమ చేయిని చూపించండి"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயவுசெய்து உங்கள் இடது கையைக் காட்டவும்"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૃપા કરીને તમારો ડાબો હાથ બતાવો"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براہِ کرم اپنا بایاں ہاتھ دکھائیں"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು ನಿಮ್ಮ ಎಡಗೈಯನ್ನು ತೋರಿಸಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୟାକରି ଆପଣଙ୍କ ବାମ ହାତ ଦେଖାନ୍ତୁ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദയവായി നിങ്ങളുടെ ഇടതു കൈ കാണിക്കുക"
          }
        }
      }
    },
    "guidance.switchHand.right": {
