    "handShape.fingers.short.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Associated with quick decisions, energy and seeing the big picture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरित निर्णय, ऊर्जा और बड़ी तस्वीर देखने से जुड़ी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত সিদ্ধান্ত, উদ্যম ও বড় ছবি দেখার সঙ্গে যুক্ত।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झटपट निर्णय, ऊर्जा आणि व्यापक चित्र पाहण्याशी जोडलेली."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "త్వరిత నిర్ణయాలు, శక్తి మరియు మొత్తం చిత్రాన్ని చూడటంతో ముడిపడి ఉన్నాయి."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவான முடிவுகள், ஆற்றல் மற்றும் முழுப் படத்தைப் பார்ப்பதுடன் தொடர்புடையவை."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઝડપી નિર્ણયો, ઊર્જા અને મોટું ચિત્ર જોવા સાથે જોડાયેલી."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری فیصلوں، توانائی اور بڑی تصویر دیکھنے سے منسلک۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತ್ವರಿತ ನಿರ್ಧಾರಗಳು, ಶಕ್ತಿ ಮತ್ತು ಒಟ್ಟಾರೆ ಚಿತ್ರವನ್ನು ನೋಡುವುದಕ್ಕೆ ಸಂಬಂಧಿಸಿವೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଶୀଘ୍ର ନିଷ୍ପତ୍ତି, ଶକ୍ତି ଓ ବଡ଼ ଚିତ୍ର ଦେଖିବା ସହ ଜଡ଼ିତ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വേഗത്തിലുള്ള തീരുമാനങ്ങൾ, ഊർജ്ജം, മൊത്തം ചിത്രം കാണൽ എന്നിവയുമായി ബന്ധപ്പെട്ടവ."
          }
        }
      }
    },
    "handShape.header": {
