    "metric.continuity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuity"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निरंतरता"
          }
        },
