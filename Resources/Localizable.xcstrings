    "hand.left.tradition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Innate / Subconscious Blueprint: Reflects natural gifts, inherited instincts, and inner self."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्मजात / अवचेतन रूपरेखा: प्राकृतिक प्रतिभाओं, विरासत में मिली सहज प्रवृत्तियों और आंतरिक स्वरूप को दर्शाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহজাত / অবচেতন নকশা: প্রাকৃতিক প্রতিভা, উত্তরাধিকারসূত্রে পাওয়া প্রবৃত্তি ও অন্তরের সত্তাকে প্রতিফলিত করে।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्मजात / अंतर्मनातील आराखडा: नैसर्गिक देणग्या, वारशाने मिळालेल्या उपजत प्रवृत्ती आणि अंतरंग दर्शवतो."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సహజ / ఉపచేతన నమూనా: సహజ ప్రతిభలు, వారసత్వంగా వచ్చిన ప్రవృత్తులు మరియు అంతరంగాన్ని ప్రతిబింబిస్తుంది."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிறவி / ஆழ்மன வரைபடம்: இயற்கைத் திறமைகள், பரம்பரை உள்ளுணர்வுகள் மற்றும் அக சுயத்தைப் பிரதிபலிக்கிறது."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જન્મજાત / અર્ધજાગ્રત રૂપરેખા: કુદરતી પ્રતિભા, વારસાગત સહજ વૃત્તિઓ અને આંતરિક સ્વરૂપ દર્શાવે છે."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فطری / لاشعوری خاکہ: قدرتی صلاحیتوں، موروثی جبلتوں اور باطنی ذات کی عکاسی کرتا ہے۔"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಹಜ / ಉಪಪ್ರಜ್ಞೆಯ ನೀಲನಕ್ಷೆ: ಸಹಜ ಪ್ರತಿಭೆಗಳು, ಆನುವಂಶಿಕ ಪ್ರವೃತ್ತಿಗಳು ಮತ್ತು ಅಂತರಂಗವನ್ನು ಪ್ರತಿಬಿಂಬಿಸುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଜନ୍ମଗତ / ଅବଚେତନ ରୂପରେଖ: ପ୍ରାକୃତିକ ପ୍ରତିଭା, ବଂଶଗତ ସହଜାତ ପ୍ରବୃତ୍ତି ଓ ଅନ୍ତରାତ୍ମାକୁ ଦର୍ଶାଏ।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ജന്മസിദ്ധ / ഉപബോധ രൂപരേഖ: സ്വാഭാവിക കഴിവുകൾ, പാരമ്പര്യമായി ലഭിച്ച സഹജവാസനകൾ, ആന്തരിക സ്വത്വം എന്നിവ പ്രതിഫലിപ്പിക്കുന്നു."
          }
        }
      }
    },
